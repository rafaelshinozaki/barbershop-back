{{!-- src/email/templates/pt/club_billing_paused.hbs --}}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if Paused}}Cobrança do clube pausada{{else}}Cobrança do clube retomada{{/if}}</title>
  <style>
    body, p, h1, h2 { margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background-color: #f4f4f4; color: #333333; line-height: 1.6; }
    .container { width: 100%; max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; }
    .header { background-color: #000; color: #ffffff; padding: 20px; text-align: center; }
    .header h1 { font-size: 22px; font-weight: normal; }
    .content { padding: 30px 20px; }
    .content h2 { font-size: 20px; margin-bottom: 20px; color: #000; }
    .content p { font-size: 16px; margin-bottom: 16px; }
    .footer { background-color: #f4f4f4; color: #777777; text-align: center; padding: 20px; font-size: 14px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header"><h1>{{ShopName}}</h1></div>
    <div class="content">
      <h2>Olá, {{FullName}}!</h2>
      {{#if Paused}}
        {{#if OwnerInactive}}
          <p>A conta do estabelecimento {{ShopName}} foi desativada. A unidade não está recebendo agendamento online.</p>
        {{else}}
          <p>A unidade {{ShopName}} foi suspensa pela plataforma. Ela não está recebendo agendamento online.</p>
        {{/if}}
        <p>A cobrança do clube {{PlanName}} fica pausada: o cartão não é cobrado enquanto isso. Quando a unidade voltar, a cobrança volta.</p>
      {{/if}}
      {{#if Resumed}}
        <p>A unidade {{ShopName}} voltou a funcionar e a cobrança do clube {{PlanName}} foi retomada.</p>
      {{/if}}
      <p>Dúvida? Escreva para {{SupportEmail}}.</p>
    </div>
    <div class="footer"><p>&copy; {{Year}} {{AppName}}.</p></div>
  </div>
</body>
</html>
