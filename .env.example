PORT=3020
# development | production (em produção ligam as regras mais duras: duas
# etapas da equipe, segredos obrigatórios, sem seed de demonstração)
NODE_ENV=development

# Frontend URL - usado para CORS e links de convite
FRONTEND_URL=http://localhost:5173
# App do backoffice (repo barbershop-backoffice): origem liberada e links dos avisos pro admin
BACKOFFICE_URL=http://localhost:5180
# Mesmo valor do BACKOFFICE_GATEWAY_SECRET da API do backoffice (barbershop-backoffice-back).
# Com ele definido, operações só de admin/gerente do sistema só passam vindas de lá
# (header x-backoffice-gateway). Vazio = regra desligada (dev local sem o gateway).
BACKOFFICE_GATEWAY_SECRET=
# Duas etapas obrigatórias para contas do sistema (admin e equipe): o login
# pede o código enviado por e-mail. Sem a variável, vale só em produção.
# Antes de subir em produção, confira que o envio de e-mail funciona (senão o
# admin não recebe o código); em emergência, BACKOFFICE_REQUIRE_2FA=false.
BACKOFFICE_REQUIRE_2FA=
# Endereço público desta API — usado no descadastro com um clique dos
# e-mails de marketing (Gmail/Yahoo fazem POST em <PUBLIC_API_URL>/marketing/unsubscribe).
# Sem ele, o cabeçalho de descadastro aponta pra página do front.
PUBLIC_API_URL=http://localhost:3020

# Domínio raiz da plataforma pra subdomínio próprio de barbearia (ex.:
# barbeariavintage.<isso aqui> mostra a página pública dela). Libera esse
# padrão de host no CORS. Deixe vazio até ter um domínio de verdade
# registrado — "*.localhost" já funciona sem isso, suficiente pra testar em
# dev.
# TENANT_ROOT_DOMAIN=barbershop.app

# Stripe - substitua pelas suas chaves em https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_sua_chave_aqui
STRIPE_SECRET_KEY=sk_test_sua_chave_aqui
STRIPE_WEBHOOK_SECRET=whsec_sua_chave_aqui
# "Receber pelo app" (Stripe Connect Express, opcional para cada unidade).
# Ative o Connect no painel do Stripe e crie um endpoint de webhook para
# "eventos de contas conectadas" com o evento account.updated, apontando
# para o mesmo /stripe/webhook; o segredo dele vai aqui. Fora de produção,
# sem chave do Stripe, um fornecedor falso faz o papel do cadastro.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_sua_chave_aqui
# Verificação de identidade (Stripe Identity) de quem atende a domicílio.
# O webhook acima precisa assinar os eventos identity.verification_session.*
# (processing, requires_input, verified, canceled).
# Fora de produção o padrão é "fake" (página de teste, sem Stripe); "stripe"
# usa o Stripe Identity de verdade. Em produção é sempre o Stripe.
# IDENTITY_PROVIDER=stripe

# Notificação no celular/navegador (Web Push). Gere o par uma vez com
# `npx web-push generate-vapid-keys` e não troque depois: trocar invalida
# todas as inscrições. Sem as chaves, o app não oferece a notificação.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@barbershop.com.br

# Sem connection_limit/pool_timeout na URL, a API usa 10 conexões e espera
# até 10 s por uma livre (os workers da fila dividem o mesmo pool)
DATABASE_URL="postgresql://user:password@localhost:5432/barbershop"

# Redis: filas de e-mail/WhatsApp e tarefas agendadas (BullMQ) + código de
# login/bloqueio por tentativas compartilhados entre instâncias.
# Local: `docker compose -f infra/compose.yaml up -d redis`. Em produção use
# um Redis com persistência (appendonly) e maxmemory-policy=noeviction —
# com eviction o Redis pode apagar jobs da fila.
REDIS_URL=redis://localhost:6379
# Rate limit (throttle) também usa esse Redis, compartilhado entre instâncias.
# Atrás de load balancer/proxy, informe quantos saltos confiar no
# X-Forwarded-For pra achar o IP real do cliente (ex.: 1). Sem proxy, deixe
# comentado — senão o cliente consegue forjar o próprio IP.
# TRUST_PROXY=1
# Limite de envios por segundo somando todas as instâncias (opcional)
# EMAIL_RATE_PER_SECOND=10
# WHATSAPP_RATE_PER_SECOND=20
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=barbershop

# Email / Mailgun - substitua pelas suas credenciais em https://www.mailgun.com/
EMAIL_HOST=seu_email@gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=api@seudominio.org
EMAIL_PASS=sua_senha
MAILGUN_KEY=sua_mailgun_key
MAILGUN_API_KEY=sua_mailgun_api_key
MAILGUN_DOMAIN=sandboxxxxx.mailgun.org
MAILGUN_FROM=postmaster@sandboxxxxx.mailgun.org
EMAIL_FROM=postmaster@sandboxxxxx.mailgun.org

# PayPal - substitua pelas suas credenciais
PAYPAL_CLIENT_ID=seu_paypal_client_id
PAYPAL_CLIENT_SECRET=seu_paypal_client_secret
PAYPAL_MODE=sandbox

# Sessão e JWT
SESSION_SECRET=gere_uma_chave_secreta_aleatoria
SESSION_MAX_AGE=36000
JWT_SECRET=gere_uma_chave_secreta_aleatoria
JWT_EXPIRATION=3600
# Assinatura dos links enviados por e-mail (gerenciar agendamento, sair da
# lista de espera, descadastro de marketing). Sem eles usa JWT_SECRET; em
# produção, prefira segredos próprios (trocar o JWT_SECRET não invalida os links)
# APPOINTMENT_LINK_SECRET=
# UNSUBSCRIBE_SECRET=

# Liga/desliga cada plataforma de login social de forma independente — ex.:
# ponha ENABLE_FACEBOOK_AUTH=false enquanto ainda não tiver credenciais reais
# do Facebook, sem precisar mexer no Google ou na Apple. Os botões da
# plataforma desligada retornam 404 em vez de tentar redirecionar.
ENABLE_GOOGLE_AUTH=true
ENABLE_FACEBOOK_AUTH=true
ENABLE_APPLE_AUTH=true

# Google OAuth - substitua em https://console.cloud.google.com/
# Cadastre AMBAS as redirect URIs abaixo (staff e cliente) no mesmo client ID.
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3020/auth/google/redirect
GOOGLE_CLIENT_CALLBACK_URL=http://localhost:3020/client-auth/google/redirect

# Facebook OAuth - substitua em https://developers.facebook.com/apps/
# Cadastre AMBAS as redirect URIs abaixo (staff e cliente) no mesmo app.
FACEBOOK_CLIENT_ID=seu_facebook_client_id
FACEBOOK_CLIENT_SECRET=seu_facebook_client_secret
FACEBOOK_CALLBACK_URL=http://localhost:3020/auth/facebook/redirect
FACEBOOK_CLIENT_CALLBACK_URL=http://localhost:3020/client-auth/facebook/redirect

# Apple Sign In - opcional, deixe em branco até configurar um app em
# https://developer.apple.com/account/resources/identifiers/list/serviceId
# (precisa de conta paga Apple Developer). Sem essas variáveis os botões
# "Continuar com Apple" simplesmente retornam 404 — as outras opções de
# login continuam funcionando normalmente.
# APPLE_CLIENT_ID=com.suaempresa.barbershop.web (o Services ID, não o Bundle ID do app)
# APPLE_TEAM_ID=seu_team_id
# APPLE_KEY_ID=seu_key_id
# APPLE_PRIVATE_KEY=conteudo_do_arquivo_.p8_com_quebras_de_linha_como_\n
# APPLE_CALLBACK_URL=http://localhost:3020/auth/apple/redirect
# APPLE_CLIENT_CALLBACK_URL=http://localhost:3020/client-auth/apple/redirect

# AWS S3 - substitua pelas suas credenciais
AWS_ACCESS_KEY_ID=sua_aws_access_key
AWS_SECRET_ACCESS_KEY=sua_aws_secret_key
AWS_REGION=us-east-2
# Bucket das fotos (galeria, capa, profissionais) — obrigatório para a API subir.
# A API do backoffice (barbershop-backoffice-back) lê o mesmo bucket com uma
# credencial só de leitura (s3:GetObject), pras fotos da Moderação
S3_BUCKET=seu-bucket
# S3 compatível (MinIO, R2...), opcional — vazio usa a AWS
# S3_ENDPOINT=http://localhost:9000

# WhatsApp Cloud API (Meta) - opcional; lembrete de agendamento vai só por
# e-mail se estas variáveis ficarem vazias. Configure em
# https://developers.facebook.com/apps/ > seu app > WhatsApp > API Setup.
# WHATSAPP_ACCESS_TOKEN é o token permanente (gerado via System User, não o
# token temporário de 24h que aparece por padrão na tela de teste).
# WHATSAPP_PHONE_NUMBER_ID é o "Phone number ID" do número de teste/produção.
#
# Mensagem de negócio pra cliente fora da janela de 24h de atendimento
# (é exatamente o caso de um lembrete de agendamento) exige um "template"
# pré-aprovado pela Meta — não dá pra criar isso por código. Submeta em
# Meta Business Manager > WhatsApp Manager > Message Templates, categoria
# "Utility", com o nome igual a WHATSAPP_REMINDER_TEMPLATE_NAME abaixo e
# corpo com 5 variáveis nesta ordem, por exemplo:
#   "Olá {{1}}! Lembrete do seu horário de {{2}} na {{3}}, dia {{4}} às {{5}}."
# A aprovação da Meta costuma levar de minutos a poucos dias.
# WHATSAPP_ACCESS_TOKEN=seu_token_permanente
# WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_REMINDER_TEMPLATE_NAME=appointment_reminder
# WHATSAPP_REMINDER_TEMPLATE_LANG=pt_BR
#
# Aviso de vaga na lista de espera — mesma exigência de template aprovado,
# corpo com 4 variáveis nesta ordem, por exemplo:
#   "Olá {{1}}! Abriu uma vaga em {{2}} no dia {{3}} às {{4}}. Agende o quanto antes."
# WHATSAPP_WAITLIST_TEMPLATE_NAME=waitlist_slot_available
#
# Campanha de marketing (Message Blast) — o texto que o staff escreve na
# hora vira o único parâmetro do corpo do template, por exemplo:
#   "{{1}}"
# (corpo do template = só a variável, sem texto fixo em volta — assim a
# mensagem final é exatamente o que o staff escreveu).
# WHATSAPP_MARKETING_TEMPLATE_NAME=marketing_blast

# Agendamento de posts (Instagram/Facebook) — opcional; sem estas variáveis a
# tela de "Redes sociais" só mostra "não conectado", sem quebrar o resto do
# app. Requer um app Meta em https://developers.facebook.com/apps/ com o
# produto "Facebook Login for Business" configurado e a redirect URI abaixo
# cadastrada. Publicar de verdade (fora de contas de teste do próprio app)
# exige a Meta aprovar as permissões pages_show_list, pages_read_engagement,
# pages_manage_posts, instagram_basic e instagram_content_publish via App
# Review — processo deles, pode levar dias. Sem a aprovação, só funciona
# com Páginas/contas Instagram de quem tem um papel (admin/dev/tester) no
# próprio app Meta.
# META_APP_ID=seu_app_id
# META_APP_SECRET=seu_app_secret
# META_OAUTH_REDIRECT_URI=http://localhost:3020/social/callback
# META_GRAPH_API_VERSION=v21.0

# Seed (pnpm seed — também roda no entrypoint do Docker a cada deploy, a
# menos que SKIP_SEED=true). SEED_DEMO=true cria os dados de demonstração
# (agendamentos, barbearias e clientes fictícios, contas com senha "pwned");
# SEED_RESET=true apaga tudo e recria com demo. Os dois são ignorados/recusados
# com NODE_ENV=production.
SEED_DEMO=false

# Só testes E2E (muitos logins seguidos do mesmo IP): desliga o limite de
# requisições por IP. Nunca em produção (ignorada com NODE_ENV=production).
# THROTTLE_DISABLED=true

# Produção (NODE_ENV=production): o seed só cria planos e papéis — os
# usuários-semente (senha "pwned") e a Green Barbershop são só de dev. O
# primeiro SystemAdmin vem daqui (mín. 12 caracteres; só se ainda não houver
# nenhum SystemAdmin). Contas-semente com a senha padrão viram aviso no log.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Localização automática das unidades (Nominatim, sem chave). GEOCODING_URL
# troca o serviço; GEOCODING_DISABLED=true desliga (testes/CI)
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_DISABLED=false

# Sentry: erros inesperados e request lento. Vazio = desligado (a API segue
# igual). Não manda cookie, cabeçalho de login, corpo das requisições,
# variáveis do GraphQL nem texto de comando do banco/Redis.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Fração das requisições com rastro de desempenho (0 a 1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Acima disso (ms) a requisição vira aviso de "request lento"
SENTRY_SLOW_REQUEST_MS=2000

# Trilha do que as pessoas fazem no app (Axiom). Vazio = desligada. Vai só
# id de quem fez, cargo, unidade, operação, entidade e se deu certo (nada de
# nome, e-mail, telefone, chat, senha). Retenção: 12 meses, no dataset.
AXIOM_TOKEN=
AXIOM_DATASET=
# Opcional (região EU ou proxy)
AXIOM_URL=

# Métricas a cada 60 s (requests, p95, erros, pool do Prisma, Redis, filas,
# memória, CPU, event loop): um evento por minuto por instância, type=metrics.
# Vazio = no AXIOM_DATASET; sem Axiom, só na tela Saúde do sistema
AXIOM_METRICS_DATASET=
# true = desliga a coleta
METRICS_DISABLED=
# Alertas (aviso no Sentry, no máximo 1 a cada 15 min por tipo): p95 do
# minuto, taxa de erro (só com ALERT_MIN_REQUESTS requests ou mais) e job
# esperando na fila há mais de ALERT_QUEUE_STUCK_SEC
ALERT_P95_MS=1000
ALERT_ERROR_RATE=0.02
ALERT_MIN_REQUESTS=50
ALERT_QUEUE_STUCK_SEC=600

# Backup diário do Postgres (03:30, horário de Brasília): pg_dump no formato
# do pg_restore, enviado para um bucket S3 privado. É a segunda cópia, fora do
# provedor do banco. Use um bucket só para isso (sem acesso público e com
# versionamento); sem BACKUP_S3_BUCKET, vai para o S3_BUCKET, na pasta
# BACKUP_S3_PREFIX. A credencial AWS precisa de s3:PutObject, s3:ListBucket e
# s3:DeleteObject nessa pasta. Atrasado mais que BACKUP_MAX_AGE_HOURS → alerta
# backup-stale no Sentry. Restaurar: docs/RUNBOOK.md
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/postgres
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26

# E-mail de contato do suporte nos e-mails mandados a pedido da API do
# backoffice (convite, código, senha da equipe)
SUPPORT_EMAIL=suporte@barbershop.com.br

# --- Scripts (não são lidos pela API) ---
# scripts/payment-tests: endereço da API
API_URL=http://localhost:3020
# Teste de carga (docs/LOAD_TEST.md), num banco só pra isso:
# generate.ts exige LOAD_TEST_DB=true; tamanho por LOAD_SHOPS, LOAD_BARBERS
# (por unidade) e LOAD_APPOINTMENTS (por profissional). run.mjs usa LOAD_API,
# LOAD_RUN (o "run=" impresso pelo generate), LOAD_SECONDS, LOAD_CONCURRENCY,
# LOAD_THRESHOLDS (arquivo .json de limites) e LOAD_RESULT_JSON (resultado)
LOAD_TEST_DB=
LOAD_SHOPS=3000
LOAD_BARBERS=3
LOAD_APPOINTMENTS=40
LOAD_API=http://localhost:3040
LOAD_RUN=
LOAD_SECONDS=20
LOAD_CONCURRENCY=20
LOAD_THRESHOLDS=
LOAD_RESULT_JSON=
