generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                @id @default(autoincrement())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deleted_at          DateTime?
  email               String
  provider            String             @default("local")
  password            String
  fullName            String
  idDocNumber         String
  phone               String
  gender              String
  birthdate           DateTime
  readTerms           Boolean
  membership          String             @default("FREE")
  // Plano Pro da agenda solo. Enquanto esta data está no futuro, a cota de 30 não trava.
  proUntil            DateTime?
  // Código para indicar outro profissional. Cada indicação aceita rende meses de Pro aos dois.
  proReferralCode     String?            @unique
  isActive            Boolean            @default(false)
  stripeCustomerId    String?
  trialStartDate      DateTime?
  trialEndDate        DateTime?
  isInViewerMode      Boolean            @default(false)
  viewerModeStartDate DateTime?
  roleId              Int
  twoFactorEnabled    Boolean            @default(false)
  photoKey            String?
  ActiveSession       ActiveSession[]
  address             Address?
  emailLogger         EmailLogger[]
  notificationPreference NotificationPreference?
  acceptedInvites     FriendInvite[]     @relation("AcceptedBy")
  sentInvites         FriendInvite[]     @relation("Inviter")
  proReferralsSent    ProReferral[]      @relation("ProReferralInviter")
  proReferralReceived ProReferral?       @relation("ProReferralInvited")
  invalidatedTokens   InvalidatedToken[]
  LoginHistory        LoginHistory[]
  subscriptions       Subscription[]
  role                Role               @relation(fields: [roleId], references: [id])
  userCoupons         UserCoupon[]
  notifications       UserNotification[]
  userSystemConfig    UserSystemConfig?
  verificationCodes   VerificationCode[]
  passwordResetTokens PasswordResetToken[]
  barbershopsOwned    Barbershop[]  @relation("BarbershopOwner")
  barberProfiles     Barber[]
  professional       Professional?
  networksOwned      Network[]     @relation("NetworkOwner")
  sentEmployeeInvites    EmployeeInvite[] @relation("EmployeeInviteInviter")
  acceptedEmployeeInvites EmployeeInvite[] @relation("EmployeeInviteAcceptedBy")
  cashSessionsOpened     CashSession[]    @relation("CashSessionOpenedBy")
  cashSessionsClosed     CashSession[]    @relation("CashSessionClosedBy")
  expensesCreated        Expense[]        @relation("ExpenseCreatedBy")
  linkedSocialAccounts   LinkedSocialAccount[]
  // Conta de cliente da mesma pessoa (área do cliente)
  clientAccount          ClientAccount?
  // Identidade confirmada (documento + selfie ao vivo, pelo Stripe Identity): selo "Verificado"
  identityVerifiedAt     DateTime?
  identityVerifications  IdentityVerification[]
  supportTickets         SupportTicket[]
  pushSubscriptions      PushSubscription[]

  jobApplications JobApplication[]
  @@unique([email, provider])
  calendarFeeds       CalendarFeed[]
}

// Métodos de login social adicionais conectados a uma conta (além do
// provider "principal" gravado em User.provider, que continua sendo o que
// criou a conta originalmente). Permite a mesma conta entrar tanto por
// senha quanto por Google/Facebook/Apple, em vez de criar um User separado
// por provider — antes disso, logar com um método diferente do original
// (mesmo email) criava silenciosamente uma segunda conta desconectada.
model LinkedSocialAccount {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  userId        Int
  provider      String   // google, facebook, apple
  providerEmail String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerEmail])
  @@index([userId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}

model UserSystemConfig {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  theme           String
  accentColor     String
  grayColor       String
  radius          String
  scaling         String
  panelBackground String   @default("translucent")
  language        String
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
}

model Address {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  zipcode      String
  street       String
  city         String
  neighborhood String
  state        String
  country      String
  complement1  String?
  complement2  String?
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Decimal
  billingCycle  String
  features      String?
  stripePriceId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deleted_at    DateTime?
  subscriptions Subscription[]
}

model Subscription {
  id                   Int       @id @default(autoincrement())
  userId               Int
  planId               Int
  startSubDate         DateTime
  cancelationDate      DateTime?
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Pago até quando (plano cobrado por nós, sem assinatura no Stripe): no
  // vencimento a renovação cobra o cartão salvo e empurra esta data
  currentPeriodEnd     DateTime?
  // Primeira falha da renovação do período atual (tolerância antes de rebaixar)
  renewalFailedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  payments             Payment[]
  plan                 Plan      @relation(fields: [planId], references: [id])
  user                 User      @relation(fields: [userId], references: [id])
}

model Payment {
  id              Int          @id @default(autoincrement())
  subscriptionId  Int
  amount          Decimal
  paymentDate     DateTime
  nextPaymentDate DateTime
  paymentMethod   String?
  transactionId   String?
  status          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  payerId         String?
  paymentId       String?
  appliedCouponId Int?
  originalAmount  Decimal?
  discountAmount  Decimal?
  // Renovação: "<assinatura>:<fim do período>:<tentativa>". Único — é a
  // trava que impede duas execuções de cobrar a mesma renovação
  renewalKey      String?      @unique
  appliedCoupon   Coupon?      @relation("AppliedCoupons", fields: [appliedCouponId], references: [id])
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
}

model Coupon {
  id                    Int            @id @default(autoincrement())
  code                  String         @unique
  name                  String
  description           String?
  type                  String
  value                 Decimal
  maxUses               Int?
  usedCount             Int            @default(0)
  isActive              Boolean        @default(true)
  validFrom             DateTime       @default(now())
  validUntil            DateTime?
  minSubscriptionMonths Int?
  applicablePlans       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deleted_at            DateTime?
  friendInvites         FriendInvite[] @relation("FriendCoupon")
  inviterInvites        FriendInvite[] @relation("InviterCoupon")
  payments              Payment[]      @relation("AppliedCoupons")
  userCoupons           UserCoupon[]
}

model UserCoupon {
  id        Int       @id @default(autoincrement())
  userId    Int
  couponId  Int
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  coupon    Coupon    @relation(fields: [couponId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, couponId])
}

model NotificationPreference {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  newsEmail        Boolean  @default(true)
  newsInApp        Boolean  @default(true)
  promotionsEmail  Boolean  @default(true)
  promotionsInApp  Boolean  @default(true)
  securityEmail    Boolean  @default(true)
  securityInApp    Boolean  @default(true)
  instabilityEmail Boolean  @default(true)
  instabilityInApp Boolean  @default(true)
  // Atividade das unidades (avisos do sistema pro dono, gerentes e o
  // barbeiro envolvido). E-mail desligado por padrão nas que acontecem
  // muitas vezes por dia.
  appointmentsEmail Boolean @default(false)
  appointmentsInApp Boolean @default(true)
  salesEmail       Boolean  @default(false)
  salesInApp       Boolean  @default(true)
  inventoryEmail   Boolean  @default(true)
  inventoryInApp   Boolean  @default(true)
  teamEmail        Boolean  @default(true)
  teamInApp        Boolean  @default(true)
  reviewsEmail     Boolean  @default(false)
  reviewsInApp     Boolean  @default(true)
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id])
}

model EmailLogger {
  id        Int      @id @default(autoincrement())
  userId    Int? // vazio pra e-mail de cliente final (conta de cliente não é User)
  sentTo    String
  subject   String
  body      String
  meta      String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model LoginHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  deviceType String
  browser    String
  os         String
  ip         String
  location   String
  latitude   Float? // aproximada, pelo IP (sem ela o detalhe mostra o mapa pelo nome do local)
  longitude  Float?
  // Sessão aberta por esse login — o detalhe mostra se ainda está ativa e deixa encerrar
  sessionToken String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model ActiveSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  sessionToken String   @unique
  deviceType   String
  browser      String
  os           String
  ip           String
  location     String
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model UserNotification {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  title      String
  message    String
  type       String
  isRead     Boolean  @default(false)
  isNew      Boolean  @default(true)
  actionUrl  String?
  actionText String?
  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  // Sininho: lista (userId + ordem por data) e contagem de não lidas/novas
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([userId, isNew])
  @@index([createdAt])
}

model InvalidatedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FriendInvite {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  inviterId        Int
  friendEmail      String
  inviteToken      String   @unique
  status           String   @default("PENDING")
  expiresAt        DateTime
  acceptedByUserId Int?
  inviterCouponId  Int?
  friendCouponId   Int?
  sentVia          String?
  acceptedByUser   User?    @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])
  friendCoupon     Coupon?  @relation("FriendCoupon", fields: [friendCouponId], references: [id])
  inviterCoupon    Coupon?  @relation("InviterCoupon", fields: [inviterCouponId], references: [id])
  inviter          User     @relation("Inviter", fields: [inviterId], references: [id])

  @@unique([inviterId, friendEmail])
  @@index([inviteToken])
  @@index([status])
}

// Indicação entre profissionais. Uma pessoa só pode ser indicada uma vez.
// Os meses de Pro são creditados na hora, nos dois lados.
model ProReferral {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  inviterUserId  Int
  invitedUserId  Int      @unique
  months         Int
  inviter        User     @relation("ProReferralInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invited        User     @relation("ProReferralInvited", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@index([inviterUserId])
}

model EmployeeInvite {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inviterId      Int
  barbershopId   Int
  barberId       Int
  email          String
  inviteToken    String    @unique
  role           String    // BarbershopEmployee | BarbershopManager
  status         String    @default("PENDING")
  expiresAt      DateTime
  acceptedByUserId Int?
  inviter        User      @relation("EmployeeInviteInviter", fields: [inviterId], references: [id])
  barbershop     Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber         Barber    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  acceptedByUser User?     @relation("EmployeeInviteAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([inviteToken])
  @@index([status])
  @@index([barbershopId])
}

// ============ BARBERSHOP MANAGEMENT ============

model Network {
  id             Int          @id @default(autoincrement())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  name           String?
  logoUrl        String?
  logoKey        String?      // S3 key for franchise logo (separate bucket path from user photos)
  currency       String       @default("BRL") // ISO 4217 — moeda usada por padrão nas unidades desta rede
  city           String?
  description    String?
  mission        String?
  foundationYear Int?
  // Fidelidade — desativada por padrão (loyaltyEnabled=false); os dois
  // valores abaixo só importam quando ligada. pointsPerCurrencyUnit: quantos
  // pontos o cliente ganha por unidade de moeda gasta (ex.: 1.0 = 1 ponto por
  // R$1). pointValue: quanto 1 ponto vale em desconto na hora de resgatar
  // (ex.: 0.10 = R$0,10 por ponto).
  loyaltyEnabled              Boolean @default(false)
  loyaltyPointsPerCurrencyUnit Float?
  loyaltyPointValue            Float?
  // Pontos de fidelidade concedidos ao cliente que indicou, quando o
  // indicado completa sua primeira venda paga (ver CustomerReferral).
  referralBonusPoints Int @default(50)
  // Taxa de cancelamento tardio/no-show — cobrança 100% manual, mesma
  // filosofia do sinal e do cartão-presente (staff registra o pagamento
  // depois, sem integração de pagamento nova pro cliente final). O sistema
  // só calcula quanto é devido e registra em NoShowFee; não cobra sozinho.
  // noShowFeeType: "PERCENT" (percentual do preço do serviço) ou "FIXED"
  // (valor fixo, mesma moeda da rede). lateCancellationWindowHours:
  // cancelar com menos que isso de antecedência do horário marcado já
  // conta como tardio e devido; NO_SHOW é sempre devido, não depende dessa
  // janela.
  noShowFeeEnabled            Boolean @default(false)
  noShowFeeType               String?
  noShowFeeValue              Float?
  lateCancellationWindowHours Int     @default(24)
  // Cores do app (Radix Themes) para toda a franquia — só o dono define;
  // equipe da rede herda. null = padrão do app. Arredondamento, escala e
  // claro/escuro continuam por usuário (UserSystemConfig).
  accentColor    String?
  grayColor      String?
  ownerUserId    Int
  ownerUser      User         @relation("NetworkOwner", fields: [ownerUserId], references: [id])
  barbershops    Barbershop[]
  customers      Customer[]
  favoritedBy    ClientFavorite[]
  giftCards      GiftCard[]
  referrals      CustomerReferral[]

  @@index([ownerUserId])
}

// Cartão-presente: emitido manualmente pela equipe (venda recebida em
// dinheiro/cartão/pix, como qualquer outra) e resgatado como desconto numa
// Sale futura. Sem cobrança online própria — decisão explícita de escopo
// pra não depender de integrar o Stripe pra pagamentos de cliente do
// marketplace (hoje o Stripe só cobra a assinatura da plataforma).
model GiftCard {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  networkId      Int
  code           String    @unique
  initialValue   Decimal
  remainingValue Decimal
  purchaserName  String?
  purchaserPhone String?
  purchaserEmail String?
  recipientName  String?
  message        String?
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  network        Network   @relation(fields: [networkId], references: [id], onDelete: Cascade)
  sales          Sale[]

  @@index([networkId])
}

model Barbershop {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  name           String
  slug           String    @unique
  // Subdomínio próprio da unidade (ex.: "barbeariavintage" ->
  // barbeariavintage.<domínio da plataforma>) — mesma página pública que já
  // existe em /u/:slug, só que acessível por um host próprio em vez do
  // caminho. Opcional, independente do slug (que continua controlando a URL
  // /u/:slug e não é mais editável depois de criado); precisa ser um label
  // de DNS válido (minúsculas, números, hífen — validado no service).
  subdomain      String?   @unique
  // Sinal pago online (cartão, Stripe) ao agendar pela página pública: o
  // horário fica reservado até pagar. Desligado, a equipe marca o sinal na mão
  onlineDeposit  Boolean   @default(false)
  // Tipo de estabelecimento (src/barbershop/business-types.ts): barbershop,
  // beauty_salon, nail_salon... Define o catálogo sugerido e o texto da página
  businessType   String    @default("barbershop")
  // shop = estabelecimento. solo = agenda de uma pessoa, fora do plano da
  // unidade, com cota de 30 atendimentos e 30 produtos por mês.
  practiceKind   String    @default("shop")
  address        String
  complement1    String?
  complement2    String?
  city           String
  state          String
  country        String
  postalCode     String
  latitude       Float?    // preenchido manualmente ou por geocoding — usado na busca "perto de mim"
  longitude      Float?
  phone          String
  email          String
  photoKey       String?
  // Foto de capa da página pública (larga); o photoKey é o logo
  coverKey       String?
  timezone       String    @default("America/Sao_Paulo")
  currency       String    @default("BRL") // ISO 4217 — moeda de preços, vendas, caixa e dashboard financeiro desta unidade
  businessHours  String?   // JSON: {"monday":{"start":"09:00","end":"18:00"},...}
  // "Sobre nós" da página pública (texto da unidade, até 1000 caracteres)
  description    String?
  // Contatos e redes da página pública (opcionais): WhatsApp em E.164 e
  // links completos (https://...) das redes
  whatsapp       String?
  instagramUrl   String?
  facebookUrl    String?
  linkedinUrl    String?
  isActive       Boolean   @default(true)
  featuredUntil  DateTime? // posicionamento pago "Destaque" na busca — ativado manualmente pelo admin, sem checkout automático ainda
  // Fora da vitrine pela moderação (denúncia): some da busca e do sitemap; o link direto continua
  searchHiddenAt DateTime?
  networkId      Int
  network        Network   @relation(fields: [networkId], references: [id], onDelete: Cascade)
  ownerUserId    Int?      // denormalized for backward compat / quick access
  ownerUser      User?     @relation("BarbershopOwner", fields: [ownerUserId], references: [id])
  barbers          Barber[]
  services         BarbershopService[]
  productCategories ProductCategory[]
  products         BarbershopProduct[]
  appointments     Appointment[]
  walkIns        WalkIn[]
  serviceHistory ServiceHistory[]
  sales          Sale[]
  inventoryItems InventoryItem[]
  employeeInvites EmployeeInvite[]
  cashSessions   CashSession[]
  expenses       Expense[]
  resources      Resource[]
  servicePackages ServicePackage[]
  clientPackages  ClientPackage[]
  consentForms    ConsentForm[]
  commissionRules CommissionRule[]
  payConfigs      BarberPayConfig[]
  payEntries      BarberPayEntry[]
  payouts         BarberPayout[]
  reviews         Review[]
  professionalReviews ProfessionalReview[]
  customerRatings CustomerRating[]
  tips            AppointmentTip[]
  // Espaço compartilhado (cadeira alugada, como o "Shared Location" do
  // Booksy): profissionais independentes, cada um com o seu negócio
  sharedLocationMembers SharedLocationMember[] @relation("SharedLocationHost")
  sharedLocationHosts   SharedLocationMember[] @relation("SharedLocationMember")
  waitlistEntries WaitlistEntry[]
  marketingCampaigns MarketingCampaign[]
  noShowFees      NoShowFee[]
  clientSubscriptionPlans ClientSubscriptionPlan[]
  clientSubscriptions     ClientSubscription[]
  socialConnection        SocialConnection?
  socialPosts             SocialPost[]

  jobOpenings JobOpening[]
  @@index([networkId])
  @@index([ownerUserId])
  @@index([ownerUserId, practiceKind])
  @@index([isActive])
  @@index([slug])
  // Busca por distância: o retângulo em volta do ponto corta por aqui
  @@index([latitude, longitude])
  calendarFeeds   CalendarFeed[]
  closures        BarbershopClosure[]
  photos          BarbershopPhoto[]
}

model Resource {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barbershopId Int
  name         String
  type         String   @default("ROOM") // CHAIR, ROOM, STATION, BED
  isActive     Boolean  @default(true)
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
}

model Customer {
  id              Int             @id @default(autoincrement())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  networkId       Int
  clientAccountId Int?            // conta de cliente da plataforma (opcional) — liga o histórico deste
                                   // negócio a uma conta que também compra em outros negócios
  name            String
  phone           String
  email           String?
  birthDate       DateTime?
  notes           String?
  isActive        Boolean         @default(true)
  loyaltyPoints   Int             @default(0)
  marketingOptOut Boolean         @default(false) // não incluir em campanhas de marketing (Message Blast)
  // Bloqueado pela unidade (vale pra rede toda): não agenda online nem manda mensagem no chat
  blockedAt       DateTime?
  blockedReason   String?
  blockedByUserId Int?
  network         Network         @relation(fields: [networkId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  serviceHistory ServiceHistory[]
  sales          Sale[]
  walkIns        WalkIn[]
  packages       ClientPackage[]
  consentForms   ConsentForm[]
  waitlistEntries WaitlistEntry[]
  referralsMade    CustomerReferral[] @relation("ReferralsMade")
  referralReceived CustomerReferral?  @relation("ReferralReceived")
  noShowFees       NoShowFee[]
  reviews          Review[]
  professionalReviews ProfessionalReview[]
  customerRatings CustomerRating[]

  @@index([networkId])
  @@index([networkId, phone])
  @@index([networkId, email])
  @@index([clientAccountId])
}

// Indicação entre clientes de uma mesma rede: um Customer (referrer) indica
// outro (referred), que ganha o registro ao ser criado com o código de
// indicação do primeiro. O referrer só ganha os pontos de fidelidade
// (Network.referralBonusPoints) quando o indicado completa a primeira venda
// paga — não no cadastro, pra evitar indicação fake sem gasto real (ver
// createSale). referredId é único: cada cliente só pode ter sido indicado
// uma vez.
model CustomerReferral {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  networkId     Int
  referrerId    Int
  referredId    Int       @unique
  pointsAwarded Int?
  completedAt   DateTime?
  network       Network   @relation(fields: [networkId], references: [id], onDelete: Cascade)
  referrer      Customer  @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred      Customer  @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([networkId])
  @@index([referrerId])
}

// Taxa de cancelamento tardio/no-show — cobrança manual (staff registra
// depois, mesma filosofia do sinal e do cartão-presente). Um registro por
// Appointment (appointmentId é único: calcula uma vez só, mesmo que o
// status mude de novo depois). status: PENDING (calculado, ainda não
// cobrado), COLLECTED (staff marcou como recebido) ou WAIVED (perdoado).
model NoShowFee {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  appointmentId Int       @unique
  customerId    Int
  barbershopId  Int
  amount        Decimal
  currency      String
  reason        String    // LATE_CANCELLATION, NO_SHOW
  status        String    @default("PENDING") // PENDING, COLLECTED, WAIVED
  collectedAt   DateTime?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barbershop    Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([customerId])
}

// Conta de cliente da plataforma (marketplace) — distinta do User (usado por
// donos/gerentes/funcionários). Um cliente pode ter um Customer em cada
// Network que frequenta; esta conta é o que liga esses registros entre si
// para dar histórico e favoritos cross-negócio.
/// Link de uso único enviado por e-mail (confirmar e-mail, redefinir senha).
/// Guarda só o hash SHA-256 do token.
model ClientAccountToken {
  id              Int           @id @default(autoincrement())
  clientAccountId Int
  purpose         String // VERIFY_EMAIL | RESET_PASSWORD
  tokenHash       String        @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime      @default(now())
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([clientAccountId, purpose])
}

model ClientAccount {
  id                   Int                         @id @default(autoincrement())
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  email                String                      @unique
  password             String?                     // opcional — contas criadas só via login social não têm senha
  name                 String
  phone                String?
  avatarUrl            String?
  stripeCustomerId     String?                     // Stripe Customer na conta da própria plataforma — usado pra
                                                     // assinatura recorrente de serviço (ver ClientSubscription).
                                                     // Não é Stripe Connect: o dinheiro cai na conta da plataforma.
  // Só com o e-mail confirmado a conta é ligada às fichas (Customer) das
  // barbearias com esse e-mail — antes bastava cadastrar o e-mail de outra
  // pessoa pra ver o histórico dela
  emailVerifiedAt      DateTime?
  language             String?                     // idioma dos e-mails (pt/en/es), vem do navegador no cadastro
  sessionVersion       Int                         @default(0) // sobe ao trocar a senha: derruba as sessões antigas
  // Conta excluída pelo próprio cliente (LGPD): dados pessoais apagados, a
  // linha fica só pra não levar junto os pagamentos que a barbearia recebeu
  deletedAt            DateTime?
  // Conta da equipe da mesma pessoa (mesmo e-mail, ligada com prova: a
  // senha dos dois lados). Ligada, a senha que vale nas duas telas é a da
  // equipe (User.password) e esta fica vazia.
  userId               Int?                        @unique
  linkedAt             DateTime?
  // Suspensa pelo admin da plataforma (fraude, abuso): não entra e as
  // sessões caem. Os dados continuam; suspender não é excluir.
  suspendedAt          DateTime?
  suspendedReason      String?
  suspendedByUserId    Int?
  supportTickets       SupportTicket[]
  pushSubscriptions    PushSubscription[]
  user                 User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  tokens               ClientAccountToken[]
  customers            Customer[]
  favorites            ClientFavorite[]
  favoriteBarbers      ClientFavoriteBarber[]
  linkedSocialAccounts ClientLinkedSocialAccount[]
  reviews              Review[]
  subscriptions        ClientSubscription[]
}

// Avaliação de uma unidade (Barbershop), não da rede inteira — o cliente
// avalia o lugar onde de fato foi atendido. Só quem tem pelo menos um
// Appointment COMPLETED nessa unidade pode avaliar (ver
// BarbershopService.ensureVerifiedCustomer) — evita avaliação de quem
// nunca foi cliente de verdade.
model Review {
  id              Int            @id @default(autoincrement())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  barbershopId    Int
  // Quem avaliou: a conta de cliente (avaliou logado) e/ou a ficha do
  // cliente (avaliou pelo link do e-mail pós-atendimento, sem conta)
  clientAccountId Int?
  customerId      Int?
  rating          Int // 1 a 5
  comment         String?
  barbershop      Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  // Ficha apagada pela unidade: a avaliação continua (sem o nome) — a
  // unidade não some com avaliação ruim apagando o cliente
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Resposta pública da unidade (dono/gerente), como no Booksy
  reply           String?
  repliedAt       DateTime?
  repliedByUserId Int?
  // Denúncia (avaliação abusiva): o admin da plataforma modera; oculta sai
  // da página e da nota média
  reportedAt      DateTime?
  reportReason    String?
  hiddenAt        DateTime?

  @@unique([barbershopId, clientAccountId])
  @@unique([barbershopId, customerId])
  @@index([barbershopId])
}

// Avaliação do profissional num atendimento concluído (uma por atendimento),
// feita pelo link do e-mail de fechamento. Soma entre as unidades pelo
// Professional (a conta); quem não tem conta fica só no Barber da unidade.
model ProfessionalReview {
  id             Int           @id @default(autoincrement())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointmentId  Int           @unique
  barberId       Int
  barbershopId   Int
  professionalId Int?
  // Null depois que o cliente exclui a conta (a nota fica, o texto sai)
  customerId     Int?
  rating         Int // 1 a 5
  comment        String?
  // Resposta pública do profissional
  reply          String?
  repliedAt      DateTime?
  // Ocultada pela moderação (fora da página e da nota)
  hiddenAt       DateTime?
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barber         Barber        @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barbershop     Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([professionalId, createdAt])
  @@index([barberId])
}

// Nota do cliente (item 3 do roadmap) num atendimento concluído, dada pela
// unidade ou pelo profissional que atendeu: pontualidade e trato, de 1 a 5.
// Sem texto livre sobre a pessoa; só a média aparece, pra quem atende ou vai
// atender e pro próprio cliente. Nunca é pública. Comparecimento não é nota:
// sai do histórico (concluídos x faltas).
model CustomerRating {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointmentId Int
  // unit | professional
  side          String
  barbershopId  Int
  customerId    Int
  raterUserId   Int
  punctuality   Int
  treatment     Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barbershop    Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, side])
  @@index([customerId])
}

// Caixinha (gorjeta) de um atendimento concluído, registrada na mão pela
// equipe: o dinheiro não passa pela plataforma. O cliente escolhe o destino
// (o profissional ou a unidade). Quando é do profissional mas a unidade
// recebeu (a mais no cartão, ou dinheiro/Pix no balcão), vira um lançamento
// TIP no pagamento dele (payEntryId). Registro financeiro: fica pelo prazo
// fiscal, não entra na tarefa de retenção.
model AppointmentTip {
  id              Int         @id @default(autoincrement())
  createdAt       DateTime    @default(now())
  appointmentId   Int
  barbershopId    Int
  // Profissional do atendimento (destino professional)
  barberId        Int?
  // professional | unit
  destination     String
  // CASH | PIX | CARD | STRIPE (pelo app)
  method          String
  amount          Decimal
  currency        String
  // A unidade recebeu (e repassa ao profissional no pagamento)
  receivedByUnit  Boolean     @default(false)
  payEntryId      Int?        @unique
  // Quem registrou (equipe); vazio na caixinha que o cliente deu pelo app
  createdByUserId Int?
  // Caixinha pelo app (method STRIPE): cai direto na conta de recebimento
  // de quem recebe, já sem a taxa da plataforma
  stripePaymentIntentId String? @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barbershop      Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber          Barber?     @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([barbershopId, createdAt])
  @@index([barberId])
}

model ClientLinkedSocialAccount {
  id              Int           @id @default(autoincrement())
  createdAt       DateTime      @default(now())
  clientAccountId Int
  provider        String // google, facebook, apple
  providerEmail   String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, provider])
  @@unique([provider, providerEmail])
  @@index([clientAccountId])
}

// Profissional favorito do cliente, na unidade em que atende: "agendar de
// novo com ele" leva à página da unidade já com ele escolhido
model ClientFavoriteBarber {
  id              Int           @id @default(autoincrement())
  createdAt       DateTime      @default(now())
  clientAccountId Int
  barberId        Int
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  barber          Barber        @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, barberId])
  @@index([barberId])
}

model ClientFavorite {
  id              Int           @id @default(autoincrement())
  createdAt       DateTime      @default(now())
  clientAccountId Int
  networkId       Int
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  network         Network       @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, networkId])
  @@index([networkId])
}

// A pessoa que atende, acima do vínculo em cada unidade. Quem trabalha em
// duas barbearias tem um Professional e dois Barber apontando pra ele.
model Professional {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int      @unique
  // Página /p/:slug. O padrão é oculto: nada fica público sem a pessoa escolher.
  slug      String?  @unique
  // Espelho de visibility = public, para consultas antigas.
  isPublic  Boolean  @default(false)
  // hidden | platform | public
  visibility String  @default("hidden")
  // Papéis que a pessoa oferece (barber, manager, reception). O cargo na unidade é o do Barber.
  roles      String[] @default([])
  specialties TreatmentCategory[] @default([])
  cities     String[] @default([])
  openToWork Boolean  @default(false)
  // fixed | freelance | chair_rent
  engagements String[] @default([])
  acceptedRoles String[] @default([])
  acceptingClients Boolean @default(true)
  showPhoto Boolean @default(true)
  showRating Boolean @default(true)
  showAppointmentCount Boolean @default(true)
  showReviews Boolean @default(true)
  showWorkHistory Boolean @default(true)
  showLocations Boolean @default(true)
  // Contato oculto por padrão: a conversa fica no app.
  showContact Boolean @default(false)
  // "Atendo a domicílio": só aparece no perfil depois da identidade verificada (H4); área e taxa no H5
  offersHomeService Boolean @default(false)
  // Suspenso pela moderação (denúncia): a página /p/:slug e a busca somem
  suspendedAt DateTime?
  // "Destaque" na busca de profissionais, ligado pelo admin (como o da unidade)
  featuredUntil DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbers   Barber[]
  reviews   ProfessionalReview[]
}

model Barber {
  id             Int              @id @default(autoincrement())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  barbershopId   Int
  // Um vínculo por unidade: a mesma pessoa pode estar na equipe de várias
  // unidades (até de donos diferentes), com um cargo em cada
  userId         Int?
  professionalId Int?
  staffType      String?          @default("barber") // basic | barber | reception | manager
  // Atende clientes (entra na agenda e ocupa vaga do plano). Null = pelo cargo:
  // recepção não atende, os demais atendem. Dono, gerente e recepção podem
  // ligar/desligar ("Eu também atendo")
  takesAppointments Boolean?
  name           String
  phone          String
  email          String?
  avatarUrl      String?
  // Foto enviada (S3); vale por cima do avatarUrl
  avatarKey      String?
  specialization String?
  specialties    TreatmentCategory[] @default([])
  isActive       Boolean          @default(true)
  hireDate       DateTime?
  // Vínculo temporário (freelancer): fora do período não entra na unidade
  // nem aparece pra agendar. Null = sem limite
  accessStartsAt DateTime?
  accessEndsAt   DateTime?
  barbershop     Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id])
  professional   Professional?    @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalReviews ProfessionalReview[]
  tips           AppointmentTip[]
  favoritedBy    ClientFavoriteBarber[]
  employeeInvites EmployeeInvite[]
  schedules      BarberSchedule[]
  timeOffs       BarberTimeOff[]
  appointments   Appointment[]
  serviceHistory ServiceHistory[]
  sales          Sale[]
  walkIns        WalkIn[]
  commissionRules CommissionRule[]
  payConfigs      BarberPayConfig[]
  payEntries      BarberPayEntry[]
  payouts         BarberPayout[]
  waitlistEntries WaitlistEntry[]

  @@unique([barbershopId, userId])
  @@index([barbershopId])
  @@index([userId])
  @@index([professionalId])
  @@index([barbershopId, isActive])
}

model BarberSchedule {
  id         Int      @id @default(autoincrement())
  barberId   Int
  dayOfWeek  Int      // 0=Sunday, 6=Saturday
  startTime  String   // "09:00"
  endTime    String   // "18:00"
  breakStart String?
  breakEnd   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  barber     Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

model BarberTimeOff {
  id        Int      @id @default(autoincrement())
  barberId  Int
  startAt   DateTime
  endAt     DateTime
  reason    String   // VACATION, SICK, PERSONAL, OTHER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@index([barberId, startAt, endAt])
}

// Taxonomia padronizada de tipo de tratamento — compartilhada entre o
// catálogo de serviços de cada unidade (BarbershopService.category) e as
// especialidades de cada profissional (Barber.specialties). Antes disso
// eram dois vocabulários de texto livre desalinhados (category tinha
// HAIRCUT/BEARD/COMBO/COLORING/STYLING/OTHER, specialties tinha
// HAIR/BEARD/NAILS/SKIN/BROWS_LASHES/MASSAGE/MAKEUP/WELLNESS/WAXING) — o
// que fazia a busca cruzada entre negócios (searchBarbershops) depender de
// cada unidade ter digitado a categoria do jeito certo pra combinar com as
// outras.
enum TreatmentCategory {
  HAIR
  BEARD
  COMBO
  COLORING
  STYLING
  NAILS
  SKIN
  BROWS_LASHES
  MASSAGE
  MAKEUP
  WELLNESS
  WAXING
  OTHER
}

model BarbershopService {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  barbershopId     Int
  name             String
  icon             String?
  description      String?
  durationMinutes  Int
  price            Decimal
  category         TreatmentCategory @default(OTHER)
  depositAmount    Decimal? // sinal sugerido pra quem agendar este serviço — cobrança continua manual
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  barbershop       Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointmentServices AppointmentService[]
  walkInServices   WalkInService[]
  serviceHistory   ServiceHistory[]
  saleItems        SaleItem[]
  packages         ServicePackage[]
  waitlistEntries  WaitlistEntry[]
  subscriptionPlans ClientSubscriptionPlan[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
  @@index([barbershopId, category])
}

model ProductCategory {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barbershopId Int
  name         String
  icon         String?
  color        String?
  displayOrder Int      @default(0)
  barbershop   Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  products     BarbershopProduct[]

  @@index([barbershopId])
}

model BarbershopProduct {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barbershopId Int
  categoryId   Int?
  name         String
  icon         String?
  imageKey     String?  // S3 key for product photo
  sku          String?
  description  String?
  salePrice    Decimal
  costPrice    Decimal?
  unit         String   @default("UNIT") // UNIT, ML, L, FL_OZ, G, KG, OZ
  isActive     Boolean  @default(true)
  barbershop   Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  saleItems    SaleItem[]

  @@index([barbershopId])
  @@index([barbershopId, categoryId])
  @@unique([barbershopId, sku])
  @@index([barbershopId, isActive])
}

model Appointment {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  barbershopId Int
  customerId   Int
  barberId     Int
  resourceId   Int?
  startAt      DateTime
  endAt        DateTime
  status       String    @default("CONFIRMED") // DRAFT, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  notes        String?
  source       String    @default("PHONE") // ONLINE, PHONE, WALK_IN, IMPORT, HISTORY
  reminderSentAt DateTime?
  reviewRequestSentAt DateTime? // e-mail "como foi?" depois do atendimento (uma vez só)
  clientRatingRequestSentAt DateTime? // aviso ao profissional pra avaliar o cliente (resumo do dia)
  // Agendamento recorrente (a cada N semanas): mesmo seriesId, ordem na série
  seriesId     String?
  seriesIndex  Int?
  depositAmount  Decimal? // sinal — cobrança em pessoa, isto só registra valor combinado e se já foi pago
  depositPaid    Boolean   @default(false)
  depositPaidAt  DateTime?
  /// Sinal pago online estornado (cliente cancelou, unidade cancelou ou estorno manual)
  depositRefundedAt DateTime?
  // Sinal pago direto na conta da unidade (Stripe Connect): o repasse já
  // foi feito pelo Stripe, com a taxa da plataforma descontada
  depositStripeAccountId String?
  // Atendimento pago antes pelo app (Stripe Connect, direto na conta da
  // unidade): o preço menos o sinal. Descontado ao fechar a conta; volta
  // inteiro se o horário for cancelado.
  prepaidAmount          Decimal?
  prepaidAt              DateTime?
  prepaidPaymentIntentId String?   @unique
  prepaidStripeAccountId String?
  prepaidRefundedAt      DateTime?
  // Quanto já foi devolvido (estorno parcial); prepaidRefundedAt = devolvido inteiro
  prepaidRefundedAmount  Decimal?
  depositPaymentIntentId String? @unique // pagamento do sinal no Stripe
  // Reservado aguardando o sinal (status PENDING_PAYMENT) até esse instante
  holdExpiresAt  DateTime?
  // Lembrete "pague o sinal" enviado (uma vez só)
  holdReminderSentAt DateTime?
  barbershop   Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber       Barber         @relation(fields: [barberId], references: [id], onDelete: Cascade)
  resource     Resource?      @relation(fields: [resourceId], references: [id])
  services     AppointmentService[]
  serviceHistory ServiceHistory[]
  sale         Sale?
  noShowFee    NoShowFee?
  professionalReview ProfessionalReview?
  customerRatings CustomerRating[]
  tips           AppointmentTip[]
  chatThreads    ChatThread[]

  @@index([barbershopId])
  @@index([barbershopId, startAt])
  @@index([barbershopId, barberId, startAt])
  @@index([barbershopId, customerId, startAt])
  @@index([barbershopId, resourceId, startAt])
  @@index([status])
  @@index([status, reminderSentAt, startAt])
  @@index([status, reviewRequestSentAt, endAt])
  @@index([seriesId])
  @@index([status, holdExpiresAt])
}

model AppointmentService {
  id            Int       @id @default(autoincrement())
  appointmentId Int
  serviceId     Int
  quantity      Int       @default(1)
  unitPrice     Decimal
  notes         String?
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([serviceId])
}

// Lista de espera manual (staff adiciona o cliente): quando um agendamento
// que combina com uma entrada aqui (mesma data, mesmo barbeiro/serviço se
// especificado) é cancelado, o primeiro da fila (por createdAt) é
// notificado por WhatsApp/e-mail — não é reagendado automaticamente, só
// avisado que abriu vaga (ver checkWaitlistOnCancellation).
model WaitlistEntry {
  id           Int                @id @default(autoincrement())
  createdAt    DateTime           @default(now())
  barbershopId Int
  customerId   Int
  barberId     Int?               // null = qualquer barbeiro
  serviceId    Int?               // null = qualquer serviço
  date         DateTime           // dia desejado (comparado por data, sem hora)
  notes        String?
  status       String             @default("WAITING") // WAITING, NOTIFIED, CANCELLED
  notifiedAt   DateTime?
  // staff (a equipe pôs) ou online (o cliente entrou pela tela de agendamento)
  source       String             @default("staff")
  // E-mail informado ao entrar online: o aviso vai para ele
  contactEmail String?
  barbershop   Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber       Barber?            @relation(fields: [barberId], references: [id], onDelete: SetNull)
  service      BarbershopService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([barbershopId, status, date])
  @@index([customerId])
}

// Histórico de campanhas de marketing (Message Blast) — disparo segmentado
// por WhatsApp/e-mail pra grupos de clientes. Guarda só o resumo do envio
// (não uma linha por destinatário) — suficiente pra staff ver o que já foi
// mandado e evitar repetir a mesma campanha.
model MarketingCampaign {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  barbershopId      Int
  createdByUserId   Int
  subject           String?  // usado só no e-mail
  message           String
  segment           String   // ALL, INACTIVE, BIRTHDAY_MONTH
  inactiveDays      Int?     // só relevante quando segment = INACTIVE
  sentByEmail       Boolean  @default(false)
  sentByWhatsapp    Boolean  @default(false)
  recipientCount    Int
  // Envio é assíncrono (fila): *QueuedCount é quantos envios entraram na
  // fila (clientes com e-mail/telefone válido); *SentCount sobe conforme os
  // workers enviam; *FailedCount conta quem falhou depois de todas as
  // tentativas. Em andamento enquanto sent + failed < queued.
  emailQueuedCount    Int      @default(0)
  whatsappQueuedCount Int      @default(0)
  emailSentCount      Int      @default(0)
  whatsappSentCount   Int      @default(0)
  emailFailedCount    Int      @default(0)
  whatsappFailedCount Int      @default(0)
  barbershop        Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId, createdAt])
}

// ============ REDES SOCIAIS (Instagram/Facebook) ============

// Conexão com a Página do Facebook (e, se houver, a conta comercial do
// Instagram vinculada a ela) usada pra publicar posts agendados. Um vínculo
// por barbearia. facebookAccessToken é o Page Access Token de longa duração
// devolvido pela Meta no fim do fluxo OAuth — nunca é exposto no GraphQL,
// só usado internamente pelo SocialService pra chamar a Graph API.
model SocialConnection {
  id                          Int      @id @default(autoincrement())
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  barbershopId                Int      @unique
  facebookPageId              String
  facebookPageName            String
  facebookAccessToken         String
  instagramBusinessAccountId  String?
  instagramUsername           String?
  connectedByUserId           Int
  barbershop                  Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

// Post agendado pra publicar no Instagram e/ou Facebook. status: SCHEDULED
// (aguardando o horário), PUBLISHED, FAILED (erro na publicação, ver
// errorMessage). Publicado por polling (SocialPostsScheduler, cron a cada
// poucos minutos) — não tem fila de jobs no projeto, e granularidade de
// minutos é suficiente pra post de marketing.
model SocialPost {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  barbershopId      Int
  createdByUserId   Int
  caption           String
  imageKey          String    // chave no S3, mesma convenção de foto de perfil/franquia
  postToFacebook    Boolean   @default(true)
  postToInstagram   Boolean   @default(true)
  scheduledFor      DateTime
  status            String    @default("SCHEDULED")
  publishedAt       DateTime?
  facebookPostId    String?
  instagramMediaId  String?
  errorMessage      String?
  barbershop        Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([status, scheduledFor])
}

model WalkIn {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  barbershopId   Int
  customerId     Int?
  barberId       Int?
  customerName   String
  customerPhone  String?
  status         String    @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED, CANCELLED
  queuePosition  Int       @default(0)
  servedAt       DateTime?
  barbershop     Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id])
  barber         Barber?       @relation(fields: [barberId], references: [id])
  services       WalkInService[]
  serviceHistory ServiceHistory[]

  @@index([barbershopId])
  @@index([barbershopId, status, createdAt])
  @@index([barbershopId, queuePosition])
}

model WalkInService {
  id        Int       @id @default(autoincrement())
  walkInId  Int
  serviceId Int
  quantity  Int       @default(1)
  notes     String?
  walkIn    WalkIn            @relation(fields: [walkInId], references: [id], onDelete: Cascade)
  service   BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([walkInId])
  @@index([serviceId])
}

model ServiceHistory {
  id             Int       @id @default(autoincrement())
  barbershopId   Int
  customerId     Int
  barberId       Int
  appointmentId  Int?
  walkInId       Int?
  serviceId      Int
  performedAt    DateTime
  priceCharged   Decimal
  durationMinutes Int?
  notes          String?
  barbershop     Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber         Barber           @relation(fields: [barberId], references: [id], onDelete: Cascade)
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id])
  walkIn         WalkIn?          @relation(fields: [walkInId], references: [id])
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]

  @@index([barbershopId])
  @@index([customerId])
  @@index([barbershopId, performedAt])
  @@index([barberId])
  @@index([serviceId])
}

model Sale {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  barbershopId   Int
  customerId     Int?
  barberId       Int?
  appointmentId  Int?      @unique
  cashSessionId  Int?
  saleType       String    // SERVICE, PRODUCT, MIXED
  subtotal       Decimal
  discountAmount Decimal   @default(0)
  taxAmount      Decimal   @default(0)
  total          Decimal
  paymentStatus  String    @default("PENDING") // PENDING, PAID, REFUNDED, PARTIAL
  paymentMethod  String?   // CASH, CARD, PIX, etc.
  paidAt         DateTime?
  giftCardId           Int?
  giftCardAmountApplied Decimal?
  loyaltyPointsEarned   Int?
  loyaltyPointsRedeemed Int?
  loyaltyDiscountAmount Decimal?
  // Sinal já pago (online ou na mão) descontado ao fechar a conta do horário
  depositApplied Decimal?
  // Parte paga antes pelo app (Appointment.prepaidAmount), descontada
  prepaidApplied Decimal?
  barbershop     Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer       Customer?  @relation(fields: [customerId], references: [id])
  barber         Barber?    @relation(fields: [barberId], references: [id])
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id])
  giftCard       GiftCard?  @relation(fields: [giftCardId], references: [id])
  items          SaleItem[]

  @@index([barbershopId])
  @@index([barbershopId, createdAt])
  @@index([customerId])
  @@index([barberId])
  @@index([paymentStatus])
  @@index([cashSessionId])
  @@index([giftCardId])
}

model CashSession {
  id              Int       @id @default(autoincrement())
  barbershopId    Int
  openedByUserId  Int
  openedAt        DateTime  @default(now())
  openingBalance  Decimal
  closedByUserId  Int?
  closedAt        DateTime?
  countedBalance  Decimal?
  expectedBalance Decimal?
  difference      Decimal?
  status          String    @default("OPEN") // OPEN, CLOSED
  notes           String?
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  openedBy        User       @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedBy        User?      @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  sales           Sale[]
  expenses        Expense[]

  @@index([barbershopId])
  @@index([barbershopId, status])
}

model Expense {
  id              Int          @id @default(autoincrement())
  barbershopId    Int
  cashSessionId   Int?
  category        String       // RENT, UTILITIES, SUPPLIES, SALARY, MAINTENANCE, OTHER
  description     String
  amount          Decimal
  paymentMethod   String?      // CASH, CARD, PIX, TRANSFER
  expenseDate     DateTime     @default(now())
  createdByUserId Int
  createdAt       DateTime     @default(now())
  barbershop      Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  cashSession     CashSession? @relation(fields: [cashSessionId], references: [id])
  createdBy       User         @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])

  @@index([barbershopId])
  @@index([barbershopId, expenseDate])
  @@index([cashSessionId])
}

model SaleItem {
  id                Int       @id @default(autoincrement())
  saleId            Int
  itemType          String    // SERVICE, PRODUCT
  serviceId         Int?
  productId         Int?
  serviceHistoryId  Int?
  quantity          Int
  unitPrice         Decimal
  totalPrice        Decimal
  notes             String?
  sale              Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service           BarbershopService? @relation(fields: [serviceId], references: [id])
  product           BarbershopProduct? @relation(fields: [productId], references: [id])
  serviceHistory    ServiceHistory?   @relation(fields: [serviceHistoryId], references: [id])

  @@index([saleId])
  @@index([serviceHistoryId])
  @@index([productId])
}

model InventoryItem {
  id             Int       @id @default(autoincrement())
  barbershopId   Int
  productId      Int
  quantity       Decimal
  unit           String    @default("UNIT")
  minQuantity    Decimal?
  lastCountedAt  DateTime?
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  barbershop     Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  product        BarbershopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]

  @@unique([barbershopId, productId])
  @@index([barbershopId])
  @@index([productId])
  @@index([barbershopId, quantity])
}

model InventoryMovement {
  id               Int       @id @default(autoincrement())
  inventoryItemId  Int
  movementType     String    // PURCHASE, SALE, ADJUSTMENT, LOSS, TRANSFER
  quantityChange   Decimal
  quantityBefore   Decimal
  quantityAfter    Decimal
  referenceType    String?   // SALE, MANUAL, etc.
  referenceId      String?
  notes            String?
  createdAt        DateTime  @default(now())
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
}

// ============ PACOTES DE SESSÃO ============

model ServicePackage {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  barbershopId   Int
  serviceId      Int
  name           String
  totalSessions  Int
  price          Decimal
  isActive       Boolean  @default(true)
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientPackages ClientPackage[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
}

model ClientPackage {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  barbershopId     Int
  customerId       Int
  servicePackageId Int
  totalSessions    Int      // copiado da oferta no momento da compra
  usedSessions     Int      @default(0)
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  barbershop       Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id])

  @@index([barbershopId])
  @@index([customerId])
  @@index([barbershopId, status])
}

// ============ ASSINATURA RECORRENTE DO CLIENTE ============
//
// Diferente do sinal, cartão-presente e taxa de no-show (todos cobrança
// manual por escolha explícita), a assinatura recorrente precisa mesmo de
// cobrança automática todo mês — não dá pra pedir pro cliente final pagar
// na mão todo mês sem perder o sentido do produto. Usa o Stripe Subscriptions
// nativo (Product/Price/Subscription) na conta da PRÓPRIA PLATAFORMA, não
// Stripe Connect: o dono da barbearia não precisa criar/onboardar conta
// nenhuma (mesma preocupação de fricção que descartou o Connect na taxa de
// no-show). O dinheiro cai inteiro na conta da plataforma; o repasse pra
// barbearia é reconciliação manual periódica (ver PLATFORM_SUBSCRIPTION_FEE_PERCENT
// em subscription.constants.ts) — o sistema só calcula quanto é devido,
// não transfere nada sozinho.

model ClientSubscriptionPlan {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  barbershopId     Int
  serviceId        Int
  name             String
  price            Decimal // valor cobrado do cliente por ciclo (mensal)
  sessionsPerCycle Int? // null = ilimitado; caso contrário, nº máximo de usos por ciclo de cobrança
  stripeProductId  String?
  stripePriceId    String?
  isActive         Boolean  @default(true)
  barbershop       Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service          BarbershopService     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  subscriptions    ClientSubscription[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
}

model ClientSubscription {
  id                   Int       @id @default(autoincrement())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  barbershopId         Int
  clientAccountId      Int
  planId               Int
  stripeSubscriptionId String    @unique
  // INCOMPLETE (aguardando confirmação do primeiro pagamento), ACTIVE,
  // PAST_DUE (fatura falhou), CANCELED.
  status               String    @default("INCOMPLETE")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  usedThisCycle        Int       @default(0) // resetado a cada invoice.payment_succeeded (novo ciclo)
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  barbershop           Barbershop                  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  clientAccount        ClientAccount               @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  plan                 ClientSubscriptionPlan      @relation(fields: [planId], references: [id])
  payments             ClientSubscriptionPayment[]

  @@index([barbershopId])
  @@index([clientAccountId])
  @@index([barbershopId, status])
}

model ClientSubscriptionPayment {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now())
  subscriptionId  Int
  stripeInvoiceId String    @unique
  amount          Decimal
  status          String // SUCCEEDED, FAILED
  periodStart     DateTime?
  periodEnd       DateTime?
  subscription    ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ============ FICHA DE ANAMNESE / CONSENTIMENTO ============

model ConsentForm {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  barbershopId  Int
  customerId    Int
  formType      String    // ANAMNESIS, ALLERGY_TEST, PHOTO_CONSENT, GENERAL
  category      String?   // categoria de serviço a que se aplica, ex.: BROWS_LASHES
  answers       String?   // JSON livre com as respostas do formulário
  signatureName String?
  signedAt      DateTime?
  expiresAt     DateTime? // ex.: teste de alergia válido por 48h antes do serviço
  status        String    @default("PENDING") // PENDING, SIGNED, EXPIRED
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([customerId])
  @@index([barbershopId, customerId, formType])
}

// ============ COMISSÃO ============

model CommissionRule {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barbershopId Int
  barberId     Int?     // null = regra padrão da unidade, aplicada a quem não tem regra própria
  itemType     String   @default("ALL") // SERVICE, PRODUCT, ALL
  percentage   Decimal
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber?    @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, barberId, itemType])
  @@index([barbershopId])
}

// ============ PAGAMENTO DA EQUIPE ============
//
// Como cada profissional da unidade é pago e tudo o que foi pago a ele, pra
// dono, gerente e o próprio profissional verem quanto sai/entra. O dinheiro
// em si sai por fora (PIX, dinheiro, transferência); o sistema registra,
// calcula e lança a despesa "Salário".

// Forma de pagamento de um profissional nesta unidade.
// payType: COMMISSION (só comissão), FIXED (só fixo), FIXED_PLUS_COMMISSION
// (fixo + comissão), GREATER_OF (o maior entre o fixo e a comissão).
// fixedAmount vale por período de pagamento (payPeriod).
model BarberPayConfig {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barberId     Int      @unique
  barbershopId Int
  payType      String   @default("COMMISSION")
  fixedAmount  Decimal?
  payPeriod    String   @default("MONTHLY") // MONTHLY, BIWEEKLY, WEEKLY
  barber       Barber     @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

// Lançamento avulso: gorjeta que o profissional tem a receber (TIP), vale ou
// adiantamento já pago (ADVANCE — vira despesa "Salário" na hora), bônus
// (BONUS) e desconto (DEDUCTION: consumo, falta, quebra...). Entra no próximo
// fechamento (payoutId preenchido quando fechado).
model BarberPayEntry {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now())
  barbershopId    Int
  barberId        Int
  type            String // TIP, ADVANCE, BONUS, DEDUCTION
  amount          Decimal
  method          String? // ADVANCE: CASH, PIX, TRANSFER, OTHER
  date            DateTime  @default(now())
  notes           String?
  payoutId        Int?
  expenseId       Int?
  cashSessionId   Int?
  createdByUserId Int
  barber          Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barbershop      Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  payout          BarberPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([barbershopId, barberId, date])
  @@index([payoutId])
}

// Fechamento pago de um período: foto do cálculo no momento do pagamento
// (vendas, comissão, fixo, gorjetas, bônus, descontos, vales) e o valor pago.
model BarberPayout {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  barbershopId      Int
  barberId          Int
  periodStart       DateTime
  periodEnd         DateTime
  payType           String
  serviceSales      Decimal
  productSales      Decimal
  salesCount        Int
  commission        Decimal
  fixedAmount       Decimal
  baseAmount        Decimal // o que vale pela forma de pagamento (fixo, comissão, os dois ou o maior)
  tips              Decimal
  bonuses           Decimal
  deductions        Decimal
  advances          Decimal
  total             Decimal // pago agora = base + gorjetas + bônus − descontos − vales
  currency          String
  method            String // CASH, PIX, TRANSFER, OTHER
  paidAt            DateTime  @default(now())
  notes             String?
  expenseId         Int?
  cashSessionId     Int?
  carryOverEntryId  Int?      // vale maior que o devido: a diferença vira vale do próximo período
  createdByUserId   Int
  barber            Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barbershop        Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  entries           BarberPayEntry[]

  @@index([barbershopId, paidAt])
  @@index([barberId, periodStart])
}

/// Profissional independente (com o próprio negócio: plano, clientes, agenda e
/// recebimentos) que atende no espaço de outra barbearia — a "cadeira
/// alugada". A página pública do espaço lista quem atende lá, e a de cada
/// profissional mostra onde ele atende. Um não vê nada dos dados do outro.
model SharedLocationMember {
  id                 Int        @id @default(autoincrement())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  hostBarbershopId   Int
  memberBarbershopId Int
  status             String     @default("PENDING") // PENDING | ACTIVE | DECLINED | REMOVED
  invitedByUserId    Int?
  respondedAt        DateTime?
  // Aluguel da cadeira: o espaço define o valor mensal e o profissional
  // autoriza o cartão; o Stripe cobra todo mês (conta da plataforma, como a
  // assinatura do cliente — o repasse ao espaço é reconciliação manual).
  // rentStatus: NONE (sem aluguel), AWAITING_PAYMENT (valor definido,
  // aguardando o profissional autorizar o cartão), INCOMPLETE (primeira
  // cobrança pendente), ACTIVE, PAST_DUE (cobrança recusada)
  rentAmount               Decimal?
  rentCurrency             String?
  rentStatus               String     @default("NONE")
  rentStripePriceId        String?
  rentStripeSubscriptionId String?    @unique
  rentPayerUserId          Int?
  rentPaidUntil            DateTime?
  // CARD: cartão autorizado pelo profissional, cobrado pelo Stripe todo mês.
  // MANUAL: pago direto ao espaço (PIX, dinheiro, transferência...) — o
  // sistema gera a mensalidade todo mês a partir de rentStartedAt e o espaço
  // registra o pagamento. Em MANUAL, rentStatus fica ACTIVE e a situação
  // (a pagar, atrasado) vem das mensalidades em aberto.
  rentBillingMode          String     @default("CARD")
  rentStartedAt            DateTime?
  host               Barbershop @relation("SharedLocationHost", fields: [hostBarbershopId], references: [id], onDelete: Cascade)
  member             Barbershop @relation("SharedLocationMember", fields: [memberBarbershopId], references: [id], onDelete: Cascade)
  rentPayments       ChairRentPayment[]

  @@unique([hostBarbershopId, memberBarbershopId])
  @@index([memberBarbershopId])
}

// Cada cobrança mensal do aluguel da cadeira (a fatura do Stripe é o recibo)
model ChairRentPayment {
  id                     Int       @id @default(autoincrement())
  createdAt              DateTime  @default(now())
  sharedLocationMemberId Int
  stripeInvoiceId        String?   @unique // só cartão
  amount                 Decimal
  currency               String
  status                 String // DUE (mensalidade manual em aberto), SUCCEEDED, FAILED
  method                 String    @default("CARD") // CARD, CASH, PIX, TRANSFER, OTHER
  dueDate                DateTime? // mensalidade manual: vencimento
  paidAt                 DateTime?
  notes                  String?
  recordedByUserId       Int?      // quem registrou o pagamento manual
  cashSessionId          Int?      // dinheiro que entrou no caixa aberto do espaço
  memberExpenseId        Int?      // despesa "Aluguel" lançada no negócio do profissional
  overdueNotifiedAt      DateTime?
  periodStart            DateTime?
  periodEnd              DateTime?
  receiptUrl             String?
  receiptPdfUrl          String?
  link                   SharedLocationMember @relation(fields: [sharedLocationMemberId], references: [id], onDelete: Cascade)

  @@unique([sharedLocationMemberId, dueDate])
  @@index([sharedLocationMemberId])
  @@index([cashSessionId])
  @@index([status, dueDate])
}

// Link secreto de agenda (iCal) pra assinar no Google Agenda, Apple ou
// Outlook: os horários aparecem e se atualizam sozinhos. MINE = os horários
// do próprio profissional; ALL = a agenda da unidade (recepção pra cima).
// Só o hash do token fica no banco; o acesso é conferido a cada leitura
// (quem sai da equipe para de ver na hora).
model CalendarFeed {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  userId       Int
  barbershopId Int
  scope        String // MINE, ALL
  tokenHash    String     @unique
  lastAccessAt DateTime?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId, scope])
  @@index([barbershopId])
}

// Feriado, reforma, evento: a unidade fechada o dia todo ou com horário
// especial. Bloqueia a página pública (e aparece na agenda da equipe).
model BarbershopClosure {
  id              Int        @id @default(autoincrement())
  createdAt       DateTime   @default(now())
  barbershopId    Int
  date            String // YYYY-MM-DD no fuso da unidade
  openTime        String? // horário especial ("10:00"); sem = fechado o dia todo
  closeTime       String?
  reason          String?
  createdByUserId Int?
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, date])
}

/// Galeria da página pública (trabalhos, ambiente), em ordem
model BarbershopPhoto {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  barbershopId Int
  key          String
  caption      String?
  position     Int        @default(0)
  // Ocultada pela moderação (denúncia): sai da galeria pública
  hiddenAt     DateTime?
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId, position])
}

// Denúncia de conteúdo público (qualquer visitante): foto da galeria,
// avaliação de profissional, perfil de profissional ou página da unidade.
// O admin da plataforma modera numa fila: ocultar, descartar ou restaurar.
model ContentReport {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now())
  // photo | professional_review | professional_profile | barbershop
  targetType       String
  targetId         Int
  // offensive | spam | fake | inappropriate_image | impersonation | other
  reason           String
  details          String?
  // HMAC do IP de quem denunciou: evita a mesma pessoa denunciar o mesmo item várias vezes
  reporterKey      String
  // open | dismissed | actioned
  status           String    @default("open")
  resolvedAt       DateTime?
  resolvedByUserId Int?

  @@index([targetType, targetId])
  @@index([status, createdAt])
}


// Verificação de identidade do profissional (H4), feita no Stripe Identity:
// documento com foto e selfie ao vivo. Aqui só o resultado e o id da sessão;
// as imagens ficam no Stripe e são apagadas (redact) na exclusão da conta.
model IdentityVerification {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        Int
  // stripe | fake (só fora de produção, pra desenvolvimento e testes)
  provider      String
  sessionId     String    @unique
  // pending | processing | verified | requires_input | canceled | name_mismatch
  status        String    @default("pending")
  // Motivo do Stripe quando pede de novo (ex.: document_expired, selfie_mismatch)
  lastErrorCode String?
  verifiedAt    DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Chat preso ao atendimento (H4, item 11), como o do pedido no iFood: uma
// conversa do cliente com a unidade (não existe no modo solo) e outra com o
// profissional que atende. Cada uma só de quem participa; o telefone segue
// oculto. O texto sai 12 meses depois da última mensagem (tarefa diária).
model ChatThread {
  id               Int           @id @default(autoincrement())
  createdAt        DateTime      @default(now())
  appointmentId    Int
  // unit | professional
  kind             String
  barbershopId     Int
  customerId       Int
  // Profissional do atendimento (conversa "professional")
  barberId         Int?
  lastMessageAt    DateTime?
  // Até quando cada lado leu (não lidas = mensagens do outro lado depois disso)
  clientReadAt     DateTime?
  staffReadAt      DateTime?
  // Último e-mail avisando o cliente (no máximo um a cada 30 minutos)
  clientNotifiedAt DateTime?
  // Denúncia ou disputa aberta: a guarda segura o texto até esta data
  retainUntil      DateTime?
  // Encerrada pela moderação (denúncia): continua visível, não recebe mensagem
  closedAt         DateTime?
  appointment      Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  messages         ChatMessage[]

  @@unique([appointmentId, kind])
  @@index([barbershopId, lastMessageAt])
  @@index([barberId, lastMessageAt])
  @@index([customerId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  threadId     Int
  // client | staff
  senderSide   String
  // Quem da equipe escreveu (pra auditoria; a tela mostra a unidade ou o profissional)
  senderUserId Int?
  body         String
  thread       ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// Suporte humano: "Fale com a gente" (visitante, cliente ou equipe) e a
// fila no backoffice. Quem pediu acompanha e responde pelo link do e-mail,
// sem login. Sai 24 meses depois da última atividade.
model SupportTicket {
  id              Int              @id @default(autoincrement())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  // open (esperando o suporte) | answered (esperando quem pediu) | closed
  status          String           @default("open")
  // account | booking | payment | safety | other
  category        String
  subject         String
  name            String
  email           String
  language        String?
  userId          Int?
  clientAccountId Int?
  lastActivityAt  DateTime         @default(now())
  closedAt        DateTime?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientAccount   ClientAccount?   @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  messages        SupportMessage[]

  @@index([status, lastActivityAt])
  @@index([email])
}

model SupportMessage {
  id           Int           @id @default(autoincrement())
  createdAt    DateTime      @default(now())
  ticketId     Int
  // requester (quem pediu) | support (equipe da plataforma)
  side         String
  authorUserId Int?
  body         String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Notificação no celular/navegador (Web Push, PWA): uma inscrição por
// aparelho, da equipe (userId) ou da área do cliente (clientAccountId).
// Sai quando o serviço de push diz que ela expirou (404/410) ou quando
// ninguém a usa há 6 meses.
model PushSubscription {
  id              Int            @id @default(autoincrement())
  createdAt       DateTime       @default(now())
  lastUsedAt      DateTime       @default(now())
  endpoint        String         @unique
  p256dh          String
  auth            String
  userAgent       String?
  language        String?
  userId          Int?
  clientAccountId Int?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientAccountId])
}

// Conta de recebimento no Stripe (Connect Express), opcional: quem liga
// recebe o que passa pelo app direto na própria conta, com a taxa da
// plataforma descontada pelo Stripe. Quem não liga continua no repasse
// manual. ownerType: barbershop (sinal, pagamento) | professional (caixinha).
model PaymentAccount {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ownerType        String
  ownerId          Int
  // stripe | fake (fora de produção, sem Stripe configurado)
  provider         String
  stripeAccountId  String   @unique
  chargesEnabled   Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  detailsSubmitted Boolean  @default(false)
  // Pendência que o Stripe pede (requirements.disabled_reason)
  disabledReason   String?
  createdByUserId  Int?

  @@unique([ownerType, ownerId])
}

// Vaga para freelancer: a unidade pede alguém por um período ("preciso de
// barbeiro sábado"). Aceitar uma candidatura cria o convite com vínculo
// temporário, pelo fluxo de convite de sempre.
model JobOpening {
  id              Int                @id @default(autoincrement())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  barbershopId    Int
  createdByUserId Int
  title           String
  description     String?
  // Especialidade procurada (para filtrar); vazio = qualquer
  category        TreatmentCategory?
  // Período do vínculo, AAAA-MM-DD no fuso da unidade
  startDate       String
  endDate         String
  // Combinado de pagamento em texto livre ("R$ 200 a diária", "40% dos atendimentos")
  payInfo         String?
  // Quantas pessoas a unidade procura
  slots           Int                @default(1)
  // open | filled | closed
  status          String             @default("open")
  closedAt        DateTime?
  barbershop      Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  applications    JobApplication[]

  @@index([status, startDate])
  @@index([barbershopId])
}

model JobApplication {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  jobOpeningId Int
  // Quem se candidata (conta da equipe, com o perfil de profissional)
  userId       Int
  message      String?
  // pending | accepted | rejected | withdrawn
  status       String     @default("pending")
  decidedAt    DateTime?
  // Convite criado ao aceitar
  inviteId     Int?
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobOpeningId, userId])
  @@index([userId])
}
