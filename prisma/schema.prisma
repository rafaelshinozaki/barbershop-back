generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                @id @default(autoincrement())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deleted_at          DateTime?
  email               String
  provider            String             @default("local")
  password            String
  fullName            String
  idDocNumber         String
  phone               String
  gender              String
  birthdate           DateTime
  company             String
  jobTitle            String?
  department          String?
  professionalSegment String
  knowledgeApp        String
  readTerms           Boolean
  membership          String             @default("FREE")
  isActive            Boolean            @default(false)
  stripeCustomerId    String?
  trialStartDate      DateTime?
  trialEndDate        DateTime?
  isInViewerMode      Boolean            @default(false)
  viewerModeStartDate DateTime?
  roleId              Int
  twoFactorEnabled    Boolean            @default(false)
  photoKey            String?
  ActiveSession       ActiveSession[]
  address             Address?
  emailLogger         EmailLogger[]
  notificationPreference NotificationPreference?
  acceptedInvites     FriendInvite[]     @relation("AcceptedBy")
  sentInvites         FriendInvite[]     @relation("Inviter")
  invalidatedTokens   InvalidatedToken[]
  LoginHistory        LoginHistory[]
  subscriptions       Subscription[]
  role                Role               @relation(fields: [roleId], references: [id])
  userCoupons         UserCoupon[]
  notifications       UserNotification[]
  userSystemConfig    UserSystemConfig?
  verificationCodes   VerificationCode[]
  passwordResetTokens PasswordResetToken[]
  barbershopsOwned    Barbershop[]  @relation("BarbershopOwner")
  barberProfile      Barber?
  networksOwned      Network[]     @relation("NetworkOwner")
  sentEmployeeInvites    EmployeeInvite[] @relation("EmployeeInviteInviter")
  acceptedEmployeeInvites EmployeeInvite[] @relation("EmployeeInviteAcceptedBy")
  cashSessionsOpened     CashSession[]    @relation("CashSessionOpenedBy")
  cashSessionsClosed     CashSession[]    @relation("CashSessionClosedBy")
  expensesCreated        Expense[]        @relation("ExpenseCreatedBy")
  linkedSocialAccounts   LinkedSocialAccount[]

  @@unique([email, provider])
}

// Métodos de login social adicionais conectados a uma conta (além do
// provider "principal" gravado em User.provider, que continua sendo o que
// criou a conta originalmente). Permite a mesma conta entrar tanto por
// senha quanto por Google/Facebook/Apple, em vez de criar um User separado
// por provider — antes disso, logar com um método diferente do original
// (mesmo email) criava silenciosamente uma segunda conta desconectada.
model LinkedSocialAccount {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  userId        Int
  provider      String   // google, facebook, apple
  providerEmail String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerEmail])
  @@index([userId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model UserSystemConfig {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  theme           String
  accentColor     String
  grayColor       String
  radius          String
  scaling         String
  panelBackground String   @default("translucent")
  language        String
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
}

model Address {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  zipcode      String
  street       String
  city         String
  neighborhood String
  state        String
  country      String
  complement1  String?
  complement2  String?
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model Plan {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Decimal
  billingCycle  String
  features      String?
  stripePriceId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deleted_at    DateTime?
  subscriptions Subscription[]
}

model Subscription {
  id                   Int       @id @default(autoincrement())
  userId               Int
  planId               Int
  startSubDate         DateTime
  cancelationDate      DateTime?
  status               String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  payments             Payment[]
  plan                 Plan      @relation(fields: [planId], references: [id])
  user                 User      @relation(fields: [userId], references: [id])
}

model Payment {
  id              Int          @id @default(autoincrement())
  subscriptionId  Int
  amount          Decimal
  paymentDate     DateTime
  nextPaymentDate DateTime
  paymentMethod   String?
  transactionId   String?
  status          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  payerId         String?
  paymentId       String?
  appliedCouponId Int?
  originalAmount  Decimal?
  discountAmount  Decimal?
  appliedCoupon   Coupon?      @relation("AppliedCoupons", fields: [appliedCouponId], references: [id])
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
}

model Coupon {
  id                    Int            @id @default(autoincrement())
  code                  String         @unique
  name                  String
  description           String?
  type                  String
  value                 Decimal
  maxUses               Int?
  usedCount             Int            @default(0)
  isActive              Boolean        @default(true)
  validFrom             DateTime       @default(now())
  validUntil            DateTime?
  minSubscriptionMonths Int?
  applicablePlans       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deleted_at            DateTime?
  friendInvites         FriendInvite[] @relation("FriendCoupon")
  inviterInvites        FriendInvite[] @relation("InviterCoupon")
  payments              Payment[]      @relation("AppliedCoupons")
  userCoupons           UserCoupon[]
}

model UserCoupon {
  id        Int       @id @default(autoincrement())
  userId    Int
  couponId  Int
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  coupon    Coupon    @relation(fields: [couponId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, couponId])
}

model NotificationPreference {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  newsEmail        Boolean  @default(true)
  newsInApp        Boolean  @default(true)
  promotionsEmail  Boolean  @default(true)
  promotionsInApp  Boolean  @default(true)
  securityEmail    Boolean  @default(true)
  securityInApp    Boolean  @default(true)
  instabilityEmail Boolean  @default(true)
  instabilityInApp Boolean  @default(true)
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id])
}

model EmailLogger {
  id        Int      @id @default(autoincrement())
  userId    Int
  sentTo    String
  subject   String
  body      String
  meta      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model LoginHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  deviceType String
  browser    String
  os         String
  ip         String
  location   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model ActiveSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  sessionToken String   @unique
  deviceType   String
  browser      String
  os           String
  ip           String
  location     String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model UserNotification {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  title      String
  message    String
  type       String
  isRead     Boolean  @default(false)
  isNew      Boolean  @default(true)
  actionUrl  String?
  actionText String?
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
}

model InvalidatedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FriendInvite {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  inviterId        Int
  friendEmail      String
  inviteToken      String   @unique
  status           String   @default("PENDING")
  expiresAt        DateTime
  acceptedByUserId Int?
  inviterCouponId  Int?
  friendCouponId   Int?
  sentVia          String?
  acceptedByUser   User?    @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])
  friendCoupon     Coupon?  @relation("FriendCoupon", fields: [friendCouponId], references: [id])
  inviterCoupon    Coupon?  @relation("InviterCoupon", fields: [inviterCouponId], references: [id])
  inviter          User     @relation("Inviter", fields: [inviterId], references: [id])

  @@unique([inviterId, friendEmail])
  @@index([inviteToken])
  @@index([status])
}

model EmployeeInvite {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inviterId      Int
  barbershopId   Int
  barberId       Int
  email          String
  inviteToken    String    @unique
  role           String    // BarbershopEmployee | BarbershopManager
  status         String    @default("PENDING")
  expiresAt      DateTime
  acceptedByUserId Int?
  inviter        User      @relation("EmployeeInviteInviter", fields: [inviterId], references: [id])
  barbershop     Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber         Barber    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  acceptedByUser User?     @relation("EmployeeInviteAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([inviteToken])
  @@index([status])
  @@index([barbershopId])
}

// ============ BARBERSHOP MANAGEMENT ============

model Network {
  id             Int          @id @default(autoincrement())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  name           String?
  logoUrl        String?
  logoKey        String?      // S3 key for franchise logo (separate bucket path from user photos)
  currency       String       @default("BRL") // ISO 4217 — moeda usada por padrão nas unidades desta rede
  city           String?
  description    String?
  mission        String?
  foundationYear Int?
  ownerUserId    Int
  ownerUser      User         @relation("NetworkOwner", fields: [ownerUserId], references: [id])
  barbershops    Barbershop[]
  customers      Customer[]
  favoritedBy    ClientFavorite[]

  @@index([ownerUserId])
}

model Barbershop {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  name           String
  slug           String    @unique
  address        String
  complement1    String?
  complement2    String?
  city           String
  state          String
  country        String
  postalCode     String
  latitude       Float?    // preenchido manualmente ou por geocoding — usado na busca "perto de mim"
  longitude      Float?
  phone          String
  email          String
  photoKey       String?
  timezone       String    @default("America/Sao_Paulo")
  currency       String    @default("BRL") // ISO 4217 — moeda de preços, vendas, caixa e dashboard financeiro desta unidade
  businessHours  String?   // JSON: {"monday":{"start":"09:00","end":"18:00"},...}
  isActive       Boolean   @default(true)
  networkId      Int
  network        Network   @relation(fields: [networkId], references: [id], onDelete: Cascade)
  ownerUserId    Int?      // denormalized for backward compat / quick access
  ownerUser      User?     @relation("BarbershopOwner", fields: [ownerUserId], references: [id])
  barbers          Barber[]
  services         BarbershopService[]
  productCategories ProductCategory[]
  products         BarbershopProduct[]
  appointments     Appointment[]
  walkIns        WalkIn[]
  serviceHistory ServiceHistory[]
  sales          Sale[]
  inventoryItems InventoryItem[]
  employeeInvites EmployeeInvite[]
  cashSessions   CashSession[]
  expenses       Expense[]
  resources      Resource[]
  servicePackages ServicePackage[]
  clientPackages  ClientPackage[]
  consentForms    ConsentForm[]
  commissionRules CommissionRule[]
  reviews         Review[]

  @@index([networkId])
  @@index([ownerUserId])
  @@index([isActive])
  @@index([slug])
}

model Resource {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barbershopId Int
  name         String
  type         String   @default("ROOM") // CHAIR, ROOM, STATION, BED
  isActive     Boolean  @default(true)
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
}

model Customer {
  id              Int             @id @default(autoincrement())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  networkId       Int
  clientAccountId Int?            // conta de cliente da plataforma (opcional) — liga o histórico deste
                                   // negócio a uma conta que também compra em outros negócios
  name            String
  phone           String
  email           String?
  birthDate       DateTime?
  notes           String?
  isActive        Boolean         @default(true)
  network         Network         @relation(fields: [networkId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount?  @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  serviceHistory ServiceHistory[]
  sales          Sale[]
  walkIns        WalkIn[]
  packages       ClientPackage[]
  consentForms   ConsentForm[]

  @@index([networkId])
  @@index([networkId, phone])
  @@index([networkId, email])
  @@index([clientAccountId])
}

// Conta de cliente da plataforma (marketplace) — distinta do User (usado por
// donos/gerentes/funcionários). Um cliente pode ter um Customer em cada
// Network que frequenta; esta conta é o que liga esses registros entre si
// para dar histórico e favoritos cross-negócio.
model ClientAccount {
  id                   Int                         @id @default(autoincrement())
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  email                String                      @unique
  password             String?                     // opcional — contas criadas só via login social não têm senha
  name                 String
  phone                String?
  avatarUrl            String?
  customers            Customer[]
  favorites            ClientFavorite[]
  linkedSocialAccounts ClientLinkedSocialAccount[]
  reviews              Review[]
}

// Avaliação de uma unidade (Barbershop), não da rede inteira — o cliente
// avalia o lugar onde de fato foi atendido. Só quem tem pelo menos um
// Appointment COMPLETED nessa unidade pode avaliar (ver
// BarbershopService.ensureVerifiedCustomer) — evita avaliação de quem
// nunca foi cliente de verdade.
model Review {
  id              Int           @id @default(autoincrement())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  barbershopId    Int
  clientAccountId Int
  rating          Int // 1 a 5
  comment         String?
  barbershop      Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, clientAccountId])
  @@index([barbershopId])
}

model ClientLinkedSocialAccount {
  id              Int           @id @default(autoincrement())
  createdAt       DateTime      @default(now())
  clientAccountId Int
  provider        String // google, facebook, apple
  providerEmail   String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, provider])
  @@unique([provider, providerEmail])
  @@index([clientAccountId])
}

model ClientFavorite {
  id              Int           @id @default(autoincrement())
  createdAt       DateTime      @default(now())
  clientAccountId Int
  networkId       Int
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  network         Network       @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([clientAccountId, networkId])
  @@index([networkId])
}

model Barber {
  id             Int              @id @default(autoincrement())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  barbershopId   Int
  userId         Int?      @unique
  staffType      String?          @default("barber") // barber | manager
  name           String
  phone          String
  email          String?
  avatarUrl      String?
  specialization String?
  specialties    TreatmentCategory[] @default([])
  isActive       Boolean          @default(true)
  hireDate       DateTime?
  barbershop     Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id])
  employeeInvites EmployeeInvite[]
  schedules      BarberSchedule[]
  timeOffs       BarberTimeOff[]
  appointments   Appointment[]
  serviceHistory ServiceHistory[]
  sales          Sale[]
  walkIns        WalkIn[]
  commissionRules CommissionRule[]

  @@index([barbershopId])
  @@index([userId])
  @@index([barbershopId, isActive])
}

model BarberSchedule {
  id         Int      @id @default(autoincrement())
  barberId   Int
  dayOfWeek  Int      // 0=Sunday, 6=Saturday
  startTime  String   // "09:00"
  endTime    String   // "18:00"
  breakStart String?
  breakEnd   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  barber     Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@index([barberId])
}

model BarberTimeOff {
  id        Int      @id @default(autoincrement())
  barberId  Int
  startAt   DateTime
  endAt     DateTime
  reason    String   // VACATION, SICK, PERSONAL, OTHER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@index([barberId, startAt, endAt])
}

// Taxonomia padronizada de tipo de tratamento — compartilhada entre o
// catálogo de serviços de cada unidade (BarbershopService.category) e as
// especialidades de cada profissional (Barber.specialties). Antes disso
// eram dois vocabulários de texto livre desalinhados (category tinha
// HAIRCUT/BEARD/COMBO/COLORING/STYLING/OTHER, specialties tinha
// HAIR/BEARD/NAILS/SKIN/BROWS_LASHES/MASSAGE/MAKEUP/WELLNESS/WAXING) — o
// que fazia a busca cruzada entre negócios (searchBarbershops) depender de
// cada unidade ter digitado a categoria do jeito certo pra combinar com as
// outras.
enum TreatmentCategory {
  HAIR
  BEARD
  COMBO
  COLORING
  STYLING
  NAILS
  SKIN
  BROWS_LASHES
  MASSAGE
  MAKEUP
  WELLNESS
  WAXING
  OTHER
}

model BarbershopService {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  barbershopId     Int
  name             String
  icon             String?
  description      String?
  durationMinutes  Int
  price            Decimal
  category         TreatmentCategory @default(OTHER)
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  barbershop       Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointmentServices AppointmentService[]
  walkInServices   WalkInService[]
  serviceHistory   ServiceHistory[]
  saleItems        SaleItem[]
  packages         ServicePackage[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
  @@index([barbershopId, category])
}

model ProductCategory {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barbershopId Int
  name         String
  icon         String?
  color        String?
  displayOrder Int      @default(0)
  barbershop   Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  products     BarbershopProduct[]

  @@index([barbershopId])
}

model BarbershopProduct {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barbershopId Int
  categoryId   Int?
  name         String
  icon         String?
  imageKey     String?  // S3 key for product photo
  sku          String?
  description  String?
  salePrice    Decimal
  costPrice    Decimal?
  unit         String   @default("UNIT") // UNIT, ML, L, FL_OZ, G, KG, OZ
  isActive     Boolean  @default(true)
  barbershop   Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  saleItems    SaleItem[]

  @@index([barbershopId])
  @@index([barbershopId, categoryId])
  @@unique([barbershopId, sku])
  @@index([barbershopId, isActive])
}

model Appointment {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  barbershopId Int
  customerId   Int
  barberId     Int
  resourceId   Int?
  startAt      DateTime
  endAt        DateTime
  status       String    @default("CONFIRMED") // DRAFT, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  notes        String?
  source       String    @default("PHONE") // ONLINE, PHONE, WALK_IN
  reminderSentAt DateTime?
  barbershop   Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber       Barber         @relation(fields: [barberId], references: [id], onDelete: Cascade)
  resource     Resource?      @relation(fields: [resourceId], references: [id])
  services     AppointmentService[]
  serviceHistory ServiceHistory[]
  sale         Sale?

  @@index([barbershopId])
  @@index([barbershopId, startAt])
  @@index([barbershopId, barberId, startAt])
  @@index([barbershopId, customerId, startAt])
  @@index([barbershopId, resourceId, startAt])
  @@index([status])
  @@index([status, reminderSentAt, startAt])
}

model AppointmentService {
  id            Int       @id @default(autoincrement())
  appointmentId Int
  serviceId     Int
  quantity      Int       @default(1)
  unitPrice     Decimal
  notes         String?
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([serviceId])
}

model WalkIn {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  barbershopId   Int
  customerId     Int?
  barberId       Int?
  customerName   String
  customerPhone  String?
  status         String    @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED, CANCELLED
  queuePosition  Int       @default(0)
  servedAt       DateTime?
  barbershop     Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id])
  barber         Barber?       @relation(fields: [barberId], references: [id])
  services       WalkInService[]
  serviceHistory ServiceHistory[]

  @@index([barbershopId])
  @@index([barbershopId, status, createdAt])
  @@index([barbershopId, queuePosition])
}

model WalkInService {
  id        Int       @id @default(autoincrement())
  walkInId  Int
  serviceId Int
  quantity  Int       @default(1)
  notes     String?
  walkIn    WalkIn            @relation(fields: [walkInId], references: [id], onDelete: Cascade)
  service   BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([walkInId])
  @@index([serviceId])
}

model ServiceHistory {
  id             Int       @id @default(autoincrement())
  barbershopId   Int
  customerId     Int
  barberId       Int
  appointmentId  Int?
  walkInId       Int?
  serviceId      Int
  performedAt    DateTime
  priceCharged   Decimal
  durationMinutes Int?
  notes          String?
  barbershop     Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber         Barber           @relation(fields: [barberId], references: [id], onDelete: Cascade)
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id])
  walkIn         WalkIn?          @relation(fields: [walkInId], references: [id])
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]

  @@index([barbershopId])
  @@index([customerId])
  @@index([barbershopId, performedAt])
  @@index([barberId])
  @@index([serviceId])
}

model Sale {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  barbershopId   Int
  customerId     Int?
  barberId       Int?
  appointmentId  Int?      @unique
  cashSessionId  Int?
  saleType       String    // SERVICE, PRODUCT, MIXED
  subtotal       Decimal
  discountAmount Decimal   @default(0)
  taxAmount      Decimal   @default(0)
  total          Decimal
  paymentStatus  String    @default("PENDING") // PENDING, PAID, REFUNDED, PARTIAL
  paymentMethod  String?   // CASH, CARD, PIX, etc.
  paidAt         DateTime?
  barbershop     Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer       Customer?  @relation(fields: [customerId], references: [id])
  barber         Barber?    @relation(fields: [barberId], references: [id])
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id])
  items          SaleItem[]

  @@index([barbershopId])
  @@index([barbershopId, createdAt])
  @@index([customerId])
  @@index([barberId])
  @@index([paymentStatus])
  @@index([cashSessionId])
}

model CashSession {
  id              Int       @id @default(autoincrement())
  barbershopId    Int
  openedByUserId  Int
  openedAt        DateTime  @default(now())
  openingBalance  Decimal
  closedByUserId  Int?
  closedAt        DateTime?
  countedBalance  Decimal?
  expectedBalance Decimal?
  difference      Decimal?
  status          String    @default("OPEN") // OPEN, CLOSED
  notes           String?
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  openedBy        User       @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedBy        User?      @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  sales           Sale[]
  expenses        Expense[]

  @@index([barbershopId])
  @@index([barbershopId, status])
}

model Expense {
  id              Int          @id @default(autoincrement())
  barbershopId    Int
  cashSessionId   Int?
  category        String       // RENT, UTILITIES, SUPPLIES, SALARY, MAINTENANCE, OTHER
  description     String
  amount          Decimal
  paymentMethod   String?      // CASH, CARD, PIX, TRANSFER
  expenseDate     DateTime     @default(now())
  createdByUserId Int
  createdAt       DateTime     @default(now())
  barbershop      Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  cashSession     CashSession? @relation(fields: [cashSessionId], references: [id])
  createdBy       User         @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])

  @@index([barbershopId])
  @@index([barbershopId, expenseDate])
  @@index([cashSessionId])
}

model SaleItem {
  id                Int       @id @default(autoincrement())
  saleId            Int
  itemType          String    // SERVICE, PRODUCT
  serviceId         Int?
  productId         Int?
  serviceHistoryId  Int?
  quantity          Int
  unitPrice         Decimal
  totalPrice        Decimal
  notes             String?
  sale              Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service           BarbershopService? @relation(fields: [serviceId], references: [id])
  product           BarbershopProduct? @relation(fields: [productId], references: [id])
  serviceHistory    ServiceHistory?   @relation(fields: [serviceHistoryId], references: [id])

  @@index([saleId])
  @@index([serviceHistoryId])
  @@index([productId])
}

model InventoryItem {
  id             Int       @id @default(autoincrement())
  barbershopId   Int
  productId      Int
  quantity       Decimal
  unit           String    @default("UNIT")
  minQuantity    Decimal?
  lastCountedAt  DateTime?
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  barbershop     Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  product        BarbershopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]

  @@unique([barbershopId, productId])
  @@index([barbershopId])
  @@index([productId])
  @@index([barbershopId, quantity])
}

model InventoryMovement {
  id               Int       @id @default(autoincrement())
  inventoryItemId  Int
  movementType     String    // PURCHASE, SALE, ADJUSTMENT, LOSS, TRANSFER
  quantityChange   Decimal
  quantityBefore   Decimal
  quantityAfter    Decimal
  referenceType    String?   // SALE, MANUAL, etc.
  referenceId      String?
  notes            String?
  createdAt        DateTime  @default(now())
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
}

// ============ PACOTES DE SESSÃO ============

model ServicePackage {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  barbershopId   Int
  serviceId      Int
  name           String
  totalSessions  Int
  price          Decimal
  isActive       Boolean  @default(true)
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientPackages ClientPackage[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
}

model ClientPackage {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  barbershopId     Int
  customerId       Int
  servicePackageId Int
  totalSessions    Int      // copiado da oferta no momento da compra
  usedSessions     Int      @default(0)
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  barbershop       Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id])

  @@index([barbershopId])
  @@index([customerId])
  @@index([barbershopId, status])
}

// ============ FICHA DE ANAMNESE / CONSENTIMENTO ============

model ConsentForm {
  id            Int       @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  barbershopId  Int
  customerId    Int
  formType      String    // ANAMNESIS, ALLERGY_TEST, PHOTO_CONSENT, GENERAL
  category      String?   // categoria de serviço a que se aplica, ex.: BROWS_LASHES
  answers       String?   // JSON livre com as respostas do formulário
  signatureName String?
  signedAt      DateTime?
  expiresAt     DateTime? // ex.: teste de alergia válido por 48h antes do serviço
  status        String    @default("PENDING") // PENDING, SIGNED, EXPIRED
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([customerId])
  @@index([barbershopId, customerId, formType])
}

// ============ COMISSÃO ============

model CommissionRule {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  barbershopId Int
  barberId     Int?     // null = regra padrão da unidade, aplicada a quem não tem regra própria
  itemType     String   @default("ALL") // SERVICE, PRODUCT, ALL
  percentage   Decimal
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber?    @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, barberId, itemType])
  @@index([barbershopId])
}
